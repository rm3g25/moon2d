  BayDepth = 0.6;
  // Half out, a bay fills its arch: the well is no more hollow
  BayHolds = 0.5;
  // The nozzle hangs NozzleHang under the axle from the bay's ring
  // (engineNozzle); the fire leaves it NozzleLipInset over its bottom edge
  NozzleHang = 8.9;
  NozzleWidth = 14.0;
  NozzleHeight = 15.8;
  NozzleLipInset = 0.8;
  // Sliding out on the road, its tip goes no deeper under the road line
  NozzleRoadSink = 1.0;
  // The fire straight out of the nozzle: an orange sheath and a white-blue
  // core, fading out well short of the road under the hanging hull;
  // flickering by FlameFlicker of its length
  FlameLength = 30.0;
  FlameWidth = 8.0;
  FlameColor: TRgb = (R: 255; G: 128; B: 40);
  FlameCoreLength = 12.0;
  FlameCoreWidth = 3.2;
  FlameCoreColor: TRgb = (R: 205; G: 230; B: 255);
  FlameFlicker = 0.1;
  FlameSideTexels = 32;
  FlameLengthTexels = 128;
  // A jet whose mouth is JetReach over the road blows it into dust
  JetDustLook: TSmokeLook = (Rate: 40; Life: 1.2; Size: 4; EndSize: 24;
    Opacity: 0.45; Angle: 90; Cone: 150; Speed: 60; Drag: 0.5; Lift: 0;
    Wind: 0; Turbulence: 4; Spin: 20; Flow: sfGusty; Frequency: 2;
    Heat: 0; EndTint: (R: 90; G: 86; B: 80));
  JetDustSeeds: array [TTakeoffJet] of Cardinal = ($4A657444, $4A657464); // "JetD"
  JetReach = 40.0;
  // The glow at a nozzle's mouth, over its lip
  JetGlowSize = 22.0;
  JetGlowColor: TRgb = (R: 255; G: 150; B: 60);
  JetCoreSize = 8.0;
  JetCoreColor: TRgb = (R: 225; G: 238; B: 255);
  // The fire's warmth on the road under a jet: a flat pool, brightest with
  // the mouth on the road, gone WarmReach over it
  WarmReach = 260.0;
  WarmWidth = 70.0;
  WarmHeight = 12.0;
  WarmDrop = 4.0;
  WarmLevel = 0.5;
  WarmColor: TRgb = (R: 255; G: 140; B: 60);
  JetAxles: array [TTakeoffJet] of Integer = (FrontAxle, RearAxle);

  // Read off the art: a unit of the grid is solid where the art is this
  // opaque at its middle
  BodyAlpha = 128;
  Axles: array [0..1] of THullPoint = ((X: 61.1; Y: 107.5),
    (X: 133.2; Y: 107.5));
  WheelRadius = 20.5;
  WheelSide = 41.0;
  EyePoint: THullPoint = (X: 22.2; Y: 54.8);

function Lerp(AFrom, ATo, AAmount: Single): Single;
begin
  Result := AFrom + (ATo - AFrom) * AAmount;
end;

function SmoothStep(AShare: Single): Single;
begin
  var Share := EnsureRange(AShare, 0.0, 1.0);
  Result := Share * Share * (3 - 2 * Share);
end;

// APoint turned ADegrees clockwise about APivot, on the screen
function Turned(const APoint, APivot: TSdlFPoint; ADegrees: Single): TSdlFPoint;
begin
  var Angle := DegToRad(ADegrees);
  var AcrossX := APoint.X - APivot.X;
  var DownY := APoint.Y - APivot.Y;
  Result.X := APivot.X + AcrossX * Cos(Angle) - DownY * Sin(Angle);
  Result.Y := APivot.Y + AcrossX * Sin(Angle) + DownY * Cos(Angle);
end;

function UnitPoint(AX, AY: Single): TSdlFPoint;
begin
  Result.X := AX;
  Result.Y := AY;
end;

// The height of an edge AX across, between its two points about it; False
// off either end of it
function OutlineAt(const AOutline: array of THullPoint; AX: Single;
  out AY: Single): Boolean;
begin
  AY := 0;
  if (AX < AOutline[0].X) or (AX > AOutline[High(AOutline)].X) then
    Exit(False);
  for var i := 1 to High(AOutline) do
    if AX <= AOutline[i].X then
    begin
      var Left := AOutline[i - 1];
      var Right := AOutline[i];
      AY := Lerp(Left.Y, Right.Y, (AX - Left.X) / (Right.X - Left.X));
      Exit(True);
    end;
  Result := False;
end;

// The middle of the well, AWell across the screen, which the mast turns
// about with the sway
function MastPivot(AWell: Single): TSdlFPoint;
begin
  Result := UnitPoint(AWell, RamTop + WellY);
end;

// A point of a head's art, AX, AY units from its corner as drawn facing
// left, on the screen: the head on the top of the mast in the well at
// AWell, facing AFacing, squashed to ASquash of its width about the
// socket, all of it turned with the sway
function HeadPoint(AWell, AMast, ASway: Single; AHead: TRamHead;
  AFacing: Integer; ASquash, AX, AY: Single): TSdlFPoint;
begin
  var Shape := HeadShapes[AHead];
  var Pivot := MastPivot(AWell);
  var Upright := UnitPoint(Pivot.X - AFacing * (AX - Shape.SocketX) * ASquash,
    Pivot.Y - AMast + AY - Shape.SocketY);
  Result := Turned(Upright, Pivot, ASway);
end;

// Along ADegrees counter-clockwise from the right, a unit long, on the
// screen
function Heading(ADegrees: Single): TSdlFPoint;
begin
  var Angle := DegToRad(ADegrees);
  Result := UnitPoint(Cos(Angle), -Sin(Angle));
end;

// Degrees counter-clockwise from the right, from AFrom toward ATo
function Bearing(const AFrom, ATo: TSdlFPoint): Single;
begin
  Result := RadToDeg(ArcTan2(AFrom.Y - ATo.Y, ATo.X - AFrom.X));
end;

// The bearing as the barrel of a head facing AFacing can take it: within
// its half, from straight up to AimBelow under level. A hero on the other
// side holds it straight up, waiting for the head to turn; one too low
// holds it at its lowest. AReached - no limit held it.
function AimWithin(ABearing: Single; AFacing: Integer;
  out AReached: Boolean): Single;
begin
  AReached := False;
  Result := ABearing;
  if AFacing < 0 then
  begin
    if Result < 0 then
      Result := Result + 360;
    if (Result < 90) or (Result > 270) then
      Exit(90);
    if Result > 180 + AimBelow then
      Exit(180 + AimBelow);
  end
  else
  begin
    if (Result > 90) or (Result < -90) then
      Exit(90);
    if Result < -AimBelow then
      Exit(-AimBelow);
  end;
  AReached := True;
end;

function RamHullDef: THullDef;
begin
  Result := Default(THullDef);
  Result.SetName := RamSetName;
  Result.Width := RamWidth;
  Result.Height := RamHeight;
  Result.WearFull := 1;
  Result.Eye := EyePoint;
  Result.Wheels.Side := WheelSide;
  Result.Wheels.Radius := WheelRadius;
  Result.Wheels.Axles := [Axles[0], Axles[1]];
end;

// ---------------------------------------------------------------------------
// TShockWave
// ---------------------------------------------------------------------------

procedure TShockWave.Start(const AFrom: TSdlFPoint);
begin
  Ticks := 0;
  Threw := False;
  Reach := 0;
  for var Corner in ScreenCorners do
    Reach := Max(Reach, Hypot(Corner.X - AFrom.X, Corner.Y - AFrom.Y));
end;

procedure TShockWave.Stop;
begin
  Ticks := NoWave;
  Threw := False;
end;

// Gone once past the farthest corner
procedure TShockWave.Tick;
begin
  if not Running then
    Exit;
  Inc(Ticks);
  if Ticks > WaveTicks then
    Stop;
end;

function TShockWave.Running: Boolean;
begin
  Result := Ticks <> NoWave;
end;

function TShockWave.FrontOf(ATicks: Single): Single;
begin
  Result := Reach * EnsureRange(ATicks / WaveTicks, 0, 1);
end;

// ---------------------------------------------------------------------------
// TRam
// ---------------------------------------------------------------------------

constructor TRam.Create(const ABody: TShieldMask; ASeed: Cardinal);
begin
  Create(ABody, Default(TShieldMask), ASeed);
end;

constructor TRam.Create(const ABody, AWells: TShieldMask; ASeed: Cardinal);
begin
  inherited Create;
  FBody := ABody;
  FWells := AWells;
  FShield := TTekShield.CreateOver(ABody);
  for var i := Low(FPlates) to High(FPlates) do
    FPlates[i] := TTekShield.CreateStrip(PlateCells, PlateScale);
  FHeadShield := TTekShield.Create(BunkerShieldRadiusX, BunkerShieldRadiusY);
  // Open on top: the honeycomb only on the sides and the front, under the
  // top of the dome, where bullets are taken
  FHeadShield.OpenAbove(HatchY + OpenRowsDepth -
    HeadShapes[rhBunker].Height / 2);
  FDice.Seed := ASeed;
  FWave.Stop;
end;

destructor TRam.Destroy;
begin
  FHeadShield.Free;
  for var Plate in FPlates do
    Plate.Free;
  FShield.Free;
  inherited;
end;

procedure TRam.Place(AX: Single);
begin
  FX := AX;
  FLastX := AX;
  FHullFacing := -1;
  FShield.Mirrored := False;
  FSpeed := 0;
  FAccel := 0;
  FBraking := False;
  FMast := MastRest;
  FLastMast := MastRest;
  FSway := 0;
  FLastSway := 0;
  FSwaySpeed := 0;
  FLamps := 0;
  FLastLamps := 0;
  FLampHold := 0;
  FEyeLit := False;
  FEye := 0;
  FLastEye := 0;
  FBreathTicks := 0;
  FArmed := False;
  FLens := 0;
  FLastLens := 0;
  FHeroInFront := False;
  FHeroThrown := False;
  FClearTicks := 0;
  FShed := False;
  FShedTicks := 0;
  FLean := 0;
  FLastLean := 0;
  FWheel.Stop;
  FTakeoff.Stop;
  FRearWheel.Stop;
  FShutter := 0;
  FLastShutter := 0;
  FShutting := False;
  FHullHitTicks := NoHitTicks;
end;

// A fight from its start: the hunter on the mast with all its lives,
// facing left, the barrel level, the gun quiet, nobody pressed
procedure TRam.Arm(ALivesShare: Single);
begin
  FHead := rhHunter;
  FKilled := rhNone;
  FLivesShare := ALivesShare;
  FFullLives := Max(1, Round(HunterLives * ALivesShare));
  FLives := FFullLives;
  FThirds := 0;
  FHeadKilled := False;
  FChangePending := False;
  FFacing := -1;
  FTurnTicks := 0;
  FPastTicks := 0;
  FAim := 180;
  FLastAim := 180;
  FWant := 180;
  FInSights := False;
  FFire := rfIdle;
  FFireTicks := FirstBurstTicks;
  FLensHot := False;
  FHurtTicks := 0;
  FRowTicks := -1;
  FHitTicks := NoHitTicks;
  FGoneTicks := -1;
  FPressing := False;
  FLowTicks := 0;
  FAboveTicks := 0;
  FDeckTicks := 0;
  FHeroSeen := False;
  FForkLeft := False;
  FLadderWay := 0;
  FNextBarrel := 0;
  FHeat := 0;
  FLastHeat := 0;
  FRetreating := False;
  FRetreatTicks := 0;
  FStoodTicks := 0;
  FChased := False;
  FHatch := bhAiming;
  FHatchTicks := FirstBurstTicks;
  FLid := 0;
  FLastLid := 0;
  FNextMuzzle := 0;
  FFallBack := fbNone;
  FFallBackTicks := 0;
  FFallBackWait := 0;
  FHunt := htNone;
  FHuntTicks := 0;
  FRowsIn := False;
  FRamStandTicks := 0;
  FOverloadTicks := 0;
  FFlash := 0;
  FLastFlash := 0;
  FWave.Stop;
end;

function TRam.Start(const AOrders: TRamOrders; ALivesShare: Single): Boolean;
begin
  FOrders := AOrders;
  Result := not FEntered;
  FEntered := True;
  Inc(FArrivals);
  FShield.Rise;
  for var Plate in FPlates do
    Plate.Rise;
  FHeadShield.Rise;
  Arm(ALivesShare);
  if Result then
  begin
    Place(EnterFromX);
    FPhase := rpWaiting;
    FPhaseTicks := Round(AOrders.SilenceSeconds * LogicTicksPerSecond) +
      SilenceBeatTicks;
  end
  else
  begin
    Place(AOrders.Stop);
    FPhase := rpBreathing;
    FPhaseTicks := BreathTicks;
  end;
end;

procedure TRam.StartPastBunker(const AOrders: TRamOrders);
begin
  FOrders := AOrders;
  FEntered := True;
  Inc(FArrivals);
  FShield.Rise;
  Arm(1);
  FHead := rhNone;
  FKilled := rhBunker;
  FLives := 0;
  FChased := True;
  FRowsIn := True;
  Place(-RamWidth - PassBeyond);
  FShutting := True;
  FShutter := 1;
  FLastShutter := 1;
  FEyeLit := True;
  BeginTurn;
end;

procedure TRam.StartHanging(const AOrders: TRamOrders; AMiddleX: Single);
begin
  StartPastBunker(AOrders);
  Place(EnsureRange(AMiddleX - RamWidth / 2, 0, ScreenWidth - RamWidth));
  FHullFacing := 1;
  FShield.Mirrored := True;
  FShield.Vanish;
  FEyeLit := True;
  FShutting := True;
  FShutter := 1;
  FLastShutter := 1;
  // Stunned long since, the throw of the stun over, no drive-off asked
  FHunt := htStunned;
  FHuntTicks := StunThrowTicks;
  FStunFrom := FX;
  FStunSide := -FHullFacing;
  FWithdraw := Default(TRamWithdraw);
  // The wheels rolled off long ago; the scrape is over
  FShed := True;
  FShedTicks := ScrapeTicks;
  FTakeoff.Hang;
end;

procedure TRam.Clear;
begin
  FPhase := rpAbsent;
  FSpeed := 0;
  FEyeLit := False;
  FEye := 0;
  FArmed := False;
  FLens := 0;
  FLensHot := False;
  FFire := rfIdle;
  FPressing := False;
  FHeroInFront := False;
  FHeroThrown := False;
  FClearTicks := 0;
  FFlash := 0;
  FLastFlash := 0;
  FWave.Stop;
  FWheel.Stop;
  FRearWheel.Stop;
end;

procedure TRam.Reset;
begin
  Clear;
  FEntered := False;
end;

function TRam.Present: Boolean;
begin
  Result := not (FPhase in [rpAbsent, rpWaiting]);
end;

procedure TRam.BeginDrive(ATarget, ACruise: Single; AEntering: Boolean);
begin
  FTarget := ATarget;
  FCruise := ACruise;
  FEntering := AEntering;
  FPhase := rpDriving;
  FCue.Rumble := True;
end;

procedure TRam.BeginRest(ATicks: Integer);
begin
  FPhase := rpResting;
  FPhaseTicks := ATicks;
end;

// The far wall now and then, so no floor by a wall is safe from it; else
// somewhere the hull fits, far enough to be a leg
procedure TRam.BeginPatrolLeg;
const
  Tries = 8;
begin
  var Highest: Single := ScreenWidth - RamWidth;
  if FDice.NextUnit < WallLegShare then
  begin
    var Wall: Single := 0;
    if FX < Highest / 2 then
      Wall := Highest;
    BeginDrive(Wall, PatrolSpeed, False);
    Exit;
  end;

  var Target := Highest * FDice.NextUnit;
  for var i := 2 to Tries do
  begin
    if Abs(Target - FX) >= PatrolMinLeg then
      Break;
    Target := Highest * FDice.NextUnit;
  end;
  BeginDrive(Target, PatrolSpeed, False);
end;

// With no hero it roams; a hero low it presses, a hero high it hunts
procedure TRam.BeginLeg;
begin
  if not FHero.Alive then
    BeginPatrolLeg
  else if FPressing then
    BeginRev
  else
    BeginHuntLeg;
end;

// A short leg either way from where he stays in its sights; when no such
// leg comes up, the one farthest from him
procedure TRam.BeginHuntLeg;
const
  Tries = 8;
begin
  var Highest: Single := ScreenWidth - RamWidth;
  var Farthest := FX;
  var FarthestGap: Single := -1;
  for var i := 1 to Tries do
  begin
    var Way := HuntMinLeg + FDice.NextUnit * (HuntMaxLeg - HuntMinLeg);
    if FDice.NextUnit < 0.5 then
      Way := -Way;
    var Target := EnsureRange(FX + Way, 0, Highest);
    if Abs(Target - FX) < HuntMinLeg / 2 then
      Continue;
    if InSightsFrom(Target) then
    begin
      BeginDrive(Target, HuntSpeed, False);
      Exit;
    end;
    var Gap := Abs(Target + RamWidth / 2 - FHeroCenter.X);
    if Gap > FarthestGap then
    begin
      FarthestGap := Gap;
      Farthest := Target;
    end;
  end;
  if FarthestGap < 0 then
  begin
    Farthest := 0;
    if FX < Highest / 2 then
      Farthest := Highest;
  end;
  BeginDrive(Farthest, HuntSpeed, False);
end;

// The engine roars and the exhausts puff before the press
procedure TRam.BeginRev;
begin
  FPhase := rpRevving;
  FPhaseTicks := RevTicks;
  FCue.Rumble := True;
  FCue.Jolt := Max(FCue.Jolt, RevJolt);
end;

// The wall on the hero's side; the other one when it already stands there
function TRam.PressWall: Single;
begin
  var Highest: Single := ScreenWidth - RamWidth;
  Result := 0;
  if FHeroCenter.X > FX + RamWidth / 2 then
    Result := Highest;
  if Abs(Result - FX) < PatrolMinLeg then
    Result := Highest - Result;
end;

// Standing at ALeft, could the hunter's barrel reach him - is he no
// lower than its lowest. The sweeper rides to his row from anywhere.
function TRam.InSightsFrom(ALeft: Single): Boolean;
begin
  if FHead <> rhHunter then
    Exit(True);
  var WellMiddle := WellAt(ALeft);
  var Facing := -1;
  if FHeroCenter.X > WellMiddle then
    Facing := 1;
  var Sleeve := HeadPoint(WellMiddle, HunterMast, 0, rhHunter, Facing, 1,
    HunterSleeveX, HunterSleeveY);
  AimWithin(Bearing(Sleeve, FHeroCenter), Facing, Result);
end;

function TRam.Tick: TRamCue;
begin
  Result := Tick(Default(TRamTarget));
end;

function TRam.Tick(const ATarget: TRamTarget): TRamCue;
begin
  FCue := Default(TRamCue);
  if FPhase = rpAbsent then
    Exit(FCue);

  Inc(FAge);
  FLastX := FX;
  FLastMast := FMast;
  FLastSway := FSway;
  FLastLamps := FLamps;
  FLastEye := FEye;
  FLastLens := FLens;
  FLastAim := FAim;
  FLastHeat := FHeat;
  FLastLid := FLid;
  FLastFlash := FFlash;
  FLastLean := FLean;
  FLastShutter := FShutter;
  if FHullHitTicks < NoHitTicks then
    Inc(FHullHitTicks);
  FFlash := Max(0, FFlash - 1 / BlastFlashTicks);
  // The way out counts from the moment he lands
  if (FClearTicks > 0) and not FHeroThrown then
    Dec(FClearTicks);
  FAccel := 0;
  SeeHero(ATarget);
  TickThirds;
  TickKill;
  FWave.Tick;
  TickMode;
  TickPhase;
  TickShed;
  TickShutter;
  TickRow;
  TickSway;
  TickAim;
  TickFire;
  TickLamps;
  TickEye;
  TickLens;
  TickHeat;
  FShield.Tick;
  for var Plate in FPlates do
    Plate.Tick;
  FHeadShield.Tick;
  Result := FCue;
end;

// Where he is and how he moves, learnt over a few ticks
procedure TRam.SeeHero(const ATarget: TRamTarget);
begin
  FHero := ATarget;
  if not ATarget.Alive then
  begin
    FHeroSeen := False;
    FHeroPace := UnitPoint(0, 0);
    Exit;
  end;
  var Center := UnitPoint(ATarget.Body.X + ATarget.Body.W / 2,
    ATarget.Body.Y + ATarget.Body.H / 2);
  if FHeroSeen then
  begin
    FHeroPace.X := Lerp(FHeroPace.X, Center.X - FHeroCenter.X, PaceLearn);
    FHeroPace.Y := Lerp(FHeroPace.Y, Center.Y - FHeroCenter.Y, PaceLearn);
  end;
  FHeroCenter := Center;
  FHeroSeen := True;
end;

// One third a tick: a volley that crosses two is told over two ticks. The
// last life is a blast, not a third.
procedure TRam.TickThirds;
begin
  if (FHead = rhNone) or FHeadKilled or (Tier <= FThirds) then
    Exit;
  Inc(FThirds);
  FCue.Third := True;
end;

// The last life gone: the hunter blows up at once; the sweeper backs off
// to the right wall, overloads there and bursts at the end of it
procedure TRam.TickKill;
begin
  if not FHeadKilled then
    Exit;
  if FHead <> rhSweeper then
  begin
    KillHead;
    Exit;
  end;
  // The tick it stands at the wall the overload begins
  if FRetreating then
  begin
    TickRetreat;
    if FRetreating then
      Exit;
  end;
  if FOverloadTicks < OverloadTicks then
  begin
    Inc(FOverloadTicks);
    Exit;
  end;
  KillHead;
end;

// The gun falls silent and the head stands where it is; a machine that
// drives brakes to a stand, one that revs or rests stays standing
procedure TRam.BeginRetreat;
begin
  FFire := rfIdle;
  FTurnTicks := 0;
  FPressing := False;
  case FPhase of
    rpDriving:
      if not FEntering then
        FTarget := StopAhead;
    rpRevving:
      BeginRest(0);
  end;
end;

// A stand first, then back to the right wall; standing there, it is done
// and the overload begins
procedure TRam.TickRetreat;
begin
  if FRetreatTicks = 0 then
    BeginRetreat;
  if FRetreatTicks mod AlarmEveryTicks = 0 then
    FCue.Alarm := True;
  Inc(FRetreatTicks);
  if FPhase = rpDriving then
    Exit;
  if FStoodTicks < RetreatStandTicks then
  begin
    Inc(FStoodTicks);
    Exit;
  end;
  var Wall: Single := ScreenWidth - RamWidth;
  if FX < Wall then
    BeginDrive(Wall, RetreatSpeed, False)
  else
    FRetreating := False;
end;

// From the sweeper's blast on it keeps to the right wall: the bunker rises
// there and the chase runs there. Only the bunker's falls back and its
// hunt take it away, and the hunt goes on after the bunker is gone.
function TRam.AtTheWall: Boolean;
begin
  Result := FKilled in [rhSweeper, rhBunker];
end;

// The bunker's row lit, it waits out a breath, then drives off - once
procedure TRam.TickChaseStart;
begin
  if FChased then
    Exit;
  if FPhaseTicks > 0 then
  begin
    Dec(FPhaseTicks);
    Exit;
  end;
  FChased := True;
  FCue.Chase := True;
  FCue.Rumble := True;
end;

// Low long enough - the press; on a pad, or high, long enough - the hunt.
// An overloading head presses nobody.
procedure TRam.TickMode;
begin
  if FHeadKilled or AtTheWall then
  begin
    FPressing := False;
    Exit;
  end;
  var Low := FHero.Alive and not FHero.OnDeck and
    (FHero.Body.Y + FHero.Body.H > LowLine);
  FLowTicks := IfThen(Low, FLowTicks + 1, 0);
  FAboveTicks := IfThen(FHero.Alive and not Low, FAboveTicks + 1, 0);
  FDeckTicks := IfThen(FHero.Alive and FHero.OnDeck, FDeckTicks + 1, 0);

  if FPressing then
  begin
    if not FHero.Alive or (FDeckTicks >= LeaveOnDeckTicks) or
      (FAboveTicks >= LeaveAboveTicks) then
      FPressing := False;
    Exit;
  end;
  if FLowTicks >= PressAfterTicks then
  begin
    FPressing := True;
    PressNow;
  end;
end;

// The press begins: a rest ends at once; a hunting leg toward him runs on
// at the press's pace, one away from him brakes first
procedure TRam.PressNow;
begin
  case FPhase of
    rpResting:
      FPhaseTicks := 0;
    rpDriving:
      if not FEntering and not FChangePending then
      begin
        var Wall := PressWall;
        var Way := Sign(FSpeed);
        if (Way = 0) or (Sign(Wall - FX) = Way) then
        begin
          FTarget := Wall;
          FCruise := PressSpeeds[Tier];
        end
        else
          FTarget := StopAhead;
      end;
  end;
end;

// Where it comes to rest braking from now on, short of the walls
function TRam.StopAhead: Single;
begin
  var Pace := Abs(FSpeed);
  Result := EnsureRange(FX + Sign(FSpeed) * (Sqr(Pace) / (2 * Brake) + Pace / 2),
    0, ScreenWidth - RamWidth);
end;

// The last life gone: the head blows up, and the machine stands for the
// change - at once, or once it has braked
procedure TRam.KillHead;
begin
  FHeadKilled := False;
  FCue.Blast := True;
  var Shape := HeadShapes[FHead];
  FCue.BlastAt := HeadPoint(WellAt(FX), FMast, FSway, FHead, FFacing, TurnSquash,
    Shape.Width / 2, Shape.Height / 2);
  FCue.Jolt := Max(FCue.Jolt, HeadBlastJolt);
  FBlastAt := FCue.BlastAt;
  if FHead = rhSweeper then
  begin
    FCue.Shock := True;
    FCue.Jolt := Max(FCue.Jolt, SweeperBlastJolt);
    FFlash := 1;
    FOverloadTicks := 0;
    FWave.Start(FBlastAt);
  end;
  FKilled := FHead;
  FHead := rhNone;
  FArmed := False;
  FFire := rfIdle;
  FFallBack := fbNone;
  // The bunker's death leaves the hunt on: the machine runs on without a
  // head, nothing left to hit on it, till the hero's henshin
  if FKilled <> rhBunker then
  begin
    FHunt := htNone;
    FRamStandTicks := 0;
  end;
  FHatch := bhAiming;
  FLid := 0;
  FLensHot := False;
  FTurnTicks := 0;
  FPressing := False;
  FRowTicks := -1;
  FGoneTicks := 0;
  case FPhase of
    rpDriving:
      begin
        FChangePending := True;
        // The pass runs on off the screen: the mast sinks out there
        if FHunt <> htPassing then
          FTarget := StopAhead;
      end;
    rpResting, rpRevving:
      BeginChange;
  else
    FChangePending := True;
  end;
end;

procedure TRam.BeginChange;
begin
  FChangePending := False;
  FPhase := rpChanging;
  FPhaseTicks := 0;
  FChangeFrom := FMast;
end;

// The empty mast sinks, a beat, the next head rises and the fight goes
// on: the sweeper after the hunter, the bunker after the sweeper - and the
// breath before the chase counts from the bunker's row lit. After the
// bunker the mast stays down, the well shuts over it, and the hunt goes on
// where it was; one that had not begun (a bunker killed before its last
// third) begins now.
procedure TRam.TickChange;
begin
  Inc(FPhaseTicks);
  if FPhaseTicks <= SinkTicks then
  begin
    FMast := Lerp(FChangeFrom, MastRest, SmoothStep(FPhaseTicks / SinkTicks));
    Exit;
  end;
  var Rising := FPhaseTicks - SinkTicks - EmptyTicks;
  if Rising < 0 then
    Exit;
  if FKilled = rhBunker then
  begin
    FShutting := True;
    if FHunt = htNone then
      BeginHunt;
    BeginRest(0);
    Exit;
  end;
  if Rising = 0 then
  begin
    FHead := rhSweeper;
    if FKilled = rhSweeper then
      FHead := rhBunker;
    FFacing := -1;
    FCue.Whine := True;
    Exit;
  end;
  var Height := SweeperMast;
  if FHead = rhBunker then
    Height := BunkerMast;
  FMast := Lerp(MastRest, Height, SmoothStep(Rising / ChangeRiseTicks));
  if Rising < ChangeRiseTicks then
    Exit;
  if FHead = rhSweeper then
  begin
    LockSweeper;
    BeginRest(LockRestTicks);
  end
  else
  begin
    LockBunker;
    BeginRest(RowBootTicks + ChaseBreathTicks);
  end;
end;

// Locked on the mast with all its lives; the row comes up and the first
// sweep waits for it
procedure TRam.LockSweeper;
begin
  FArmed := True;
  FArmedTicks := 0;
  FFullLives := Max(1, Round(SweeperLives * FLivesShare));
  FLives := FFullLives;
  FThirds := 0;
  FHurtTicks := 0;
  FHitTicks := NoHitTicks;
  FGoneTicks := -1;
  FRowTicks := 0;
  FFire := rfIdle;
  FFireTicks := FirstBurstTicks;
  FPastTicks := 0;
  FForkLeft := False;
  FLadderWay := 0;
  FRowY := SweeperRowY(FMast);
end;

// Locked low on the mast with all its lives and its hatch shut; the row
// comes up and the first shell waits for it
procedure TRam.LockBunker;
begin
  FArmed := True;
  FArmedTicks := 0;
  FFullLives := Max(1, Round(BunkerLives * FLivesShare));
  FLives := FFullLives;
  FThirds := 0;
  FHurtTicks := 0;
  FHitTicks := NoHitTicks;
  FGoneTicks := -1;
  FRowTicks := 0;
  FFire := rfIdle;
  FPastTicks := 0;
  FHatch := bhAiming;
  FHatchTicks := FirstBurstTicks;
  FLid := 0;
  FNextMuzzle := 0;
  FFallBack := fbNone;
  FFallBackWait := FallBackFirstTicks;
  FHunt := htNone;
  FRowsIn := False;
  FRamStandTicks := 0;
end;

procedure TRam.TickPhase;
begin
  case FPhase of
    rpWaiting:
      if FPhaseTicks > 0 then
        Dec(FPhaseTicks)
      else
      begin
        // It comes in at speed: the drive began beyond the edge
        FSpeed := -EnterSpeed;
        BeginDrive(FOrders.Stop, EnterSpeed, True);
      end;
    rpDriving:
      TickDrive;
    rpBreathing:
      if FPhaseTicks > 0 then
        Dec(FPhaseTicks)
      else
      begin
        FEyeLit := True;
        FPhase := rpRising;
        FPhaseTicks := 0;
        FCue.Whine := True;
      end;
    rpRising:
      begin
        Inc(FPhaseTicks);
        var Share: Single := FPhaseTicks / RiseTicks;
        FMast := Lerp(MastRest, HunterMast, SmoothStep(Share));
        if Share >= 1 then
        begin
          FCue.Locked := True;
          FArmed := True;
          FArmedTicks := 0;
          FRowTicks := 0;
          BeginRest(LockRestTicks);
        end;
      end;
    rpResting:
      begin
        if FChangePending then
        begin
          BeginChange;
          Exit;
        end;
        // A dying head holds the machine as its end says; past the
        // sweeper it stands at the wall, and the road runs under it
        if FHeadKilled then
          Exit;
        if AtTheWall then
        begin
          TickChaseStart;
          TickHunt;
          TickFallBack;
          Exit;
        end;
        if FHero.Alive and not FPressing and (FHead = rhHunter) and
          not InSightsFrom(FX) then
          FPhaseTicks := Min(FPhaseTicks, HuntBlindRestTicks);
        if FPhaseTicks > 0 then
          Dec(FPhaseTicks)
        else
          BeginLeg;
      end;
    rpRevving:
      if FPhaseTicks > 0 then
        Dec(FPhaseTicks)
      else
      begin
        BeginDrive(PressWall, PressSpeeds[Tier], False);
        // The rumble has run since the rev
        FCue.Rumble := False;
      end;
    rpChanging:
      TickChange;
  end;
end;

// Up to speed and down again by Brake a tick: the brake begins where what
// is left of the way is what the speed needs to die out
procedure TRam.TickDrive;
begin
  var OldSpeed := FSpeed;
  var Way := FTarget - FX;
  var Pace := Abs(FSpeed);
  FBraking := Sqr(Pace) / (2 * Brake) + Pace / 2 >= Abs(Way);
  if FBraking then
    Pace := Max(Pace - Brake, CreepSpeed)
  else
    Pace := Min(Pace + Brake, FCruise);
  if Pace >= Abs(Way) then
  begin
    FX := FTarget;
    Arrive(OldSpeed);
    Exit;
  end;
  FSpeed := Sign(Way) * Pace;
  FX := FX + FSpeed;
  FAccel := FSpeed - OldSpeed;
end;

procedure TRam.Arrive(AOldSpeed: Single);
begin
  FSpeed := 0;
  FAccel := -AOldSpeed;
  FBraking := False;
  // Off the screen: no hiss, no jolt, and the rumble runs on
  if FHunt = htPassing then
  begin
    BeginTurn;
    Exit;
  end;
  FLamps := 1;
  FLampHold := LampHoldTicks;
  FCue.Hiss := True;
  if FEntering then
  begin
    FCue.Jolt := EntranceStopJolt;
    FPhase := rpBreathing;
    FPhaseTicks := BreathTicks;
    Exit;
  end;
  FCue.Jolt := Max(FCue.Jolt, PatrolStopJolt);
  if FChangePending then
    BeginChange
  else if FFallBack = fbLunging then
  begin
    FCue.Jolt := Max(FCue.Jolt, LungeStopJolt);
    FFallBack := fbStanding;
    FFallBackTicks := 0;
    BeginRest(0);
  end
  else if FFallBack = fbReturning then
  begin
    FFallBack := fbNone;
    FFallBackWait := NextFallBackWait;
    BeginRest(0);
  end
  else if not FHero.Alive then
    BeginRest(PatrolRestMinTicks +
      Round(FDice.NextUnit * (PatrolRestMaxTicks - PatrolRestMinTicks)))
  else if FPressing then
    BeginRest(PressRestTicks)
  else
    BeginRest(HuntRestMinTicks +
      Round(FDice.NextUnit * (HuntRestMaxTicks - HuntRestMinTicks)));
end;

// The top keeps going as the hull speeds up or brakes: it leans against
// the change of the speed and swings back about its own slow sway
procedure TRam.TickSway;
begin
  var Rest := IdleSway * Sin(2 * Pi * FAge / IdleSwayTicks);
  FSwaySpeed := FSwaySpeed - SwaySpring * (FSway - Rest) -
    SwayDamping * FSwaySpeed - SwayInertia * FAccel;
  FSway := EnsureRange(FSway + FSwaySpeed, -SwayMax, SwayMax);
end;

// The row lights a cell at a time after the lock; the clocks of the hit
// and the blast run on
procedure TRam.TickRow;
begin
  if FHitTicks < NoHitTicks then
    Inc(FHitTicks);
  if FGoneTicks >= 0 then
    Inc(FGoneTicks);
  if FRowTicks < 0 then
    Exit;
  var Before := RowLit;
  if FRowTicks < RowBootTicks then
    Inc(FRowTicks);
  if RowLit > Before then
    FCue.RowCell := True;
end;

function TRam.RowLit: Integer;
begin
  Result := 0;
  if FRowTicks > 0 then
    Result := Min(HeadRowCells, FRowTicks * HeadRowCells div RowBootTicks);
end;

function TRam.Row: TRamRow;
begin
  Result := Default(TRamRow);
  Result.HitTicks := FHitTicks;
  if Present and (FHead <> rhNone) and (FRowTicks >= 0) then
  begin
    Result.Shown := True;
    Result.Lit := RowLit;
    Result.Share := FLives / FFullLives;
    Result.Fade := 1;
  end
  else if Present and (FGoneTicks >= 0) and (FGoneTicks < RowFadeTicks) then
  begin
    Result.Shown := True;
    Result.Lit := HeadRowCells;
    Result.Fade := 1 - FGoneTicks / RowFadeTicks;
  end;
end;

function TRam.HeadTopAt(AAlpha: Single): TSdlFPoint;
begin
  var Head := FHead;
  if Head = rhNone then
    Head := rhHunter;
  Result := HeadPoint(WellAt(LeftAt(AAlpha)), MastAt(AAlpha), SwayAt(AAlpha), Head,
    FFacing, 1, HeadShapes[Head].Width / 2, 0);
end;

function TRam.Tier: Integer;
begin
  Result := 0;
  if FLives * 3 <= FFullLives * 2 then
    Result := 1;
  if FLives * 3 <= FFullLives then
    Result := 2;
end;

function TRam.CanShoot: Boolean;
begin
  Result := (FHead <> rhNone) and FArmed and not FHeadKilled and FHero.Alive and
    (FTurnTicks = 0) and (FPhase in [rpDriving, rpResting, rpRevving]) and
    not ((FPhase = rpDriving) and FEntering);
end;

// The barrel follows the hero within its half; past the vertical the
// head turns, never in the middle of a burst. While the lens burns the
// barrel holds on the point it took - or, the hose, follows him slower.
procedure TRam.TickAim;
begin
  if (FHead = rhNone) or FHeadKilled or not FHero.Alive then
  begin
    FPastTicks := 0;
    FInSights := False;
    Exit;
  end;

  if FTurnTicks > 0 then
  begin
    Dec(FTurnTicks);
    if FTurnTicks = TurnTicks div 2 then
    begin
      FFacing := -FFacing;
      FAim := 180 - FAim;
      FLastAim := FAim;
    end;
    Exit;
  end;
  if FHead = rhSweeper then
  begin
    TickRide;
    Exit;
  end;
  if FHead = rhBunker then
  begin
    TickBunkerTurn;
    Exit;
  end;

  var Sleeve := HeadPoint(WellAt(FX), FMast, FSway, rhHunter, FFacing, 1,
    HunterSleeveX, HunterSleeveY);
  FWant := AimWithin(Bearing(Sleeve, FHeroCenter), FFacing, FInSights) + FSway;

  var OtherSide := (FHeroCenter.X - Sleeve.X) * -FFacing;
  var OffVertical := RadToDeg(ArcTan2(OtherSide, Sleeve.Y - FHeroCenter.Y));
  if (OtherSide > 0) and (OffVertical > TurnPast) then
    Inc(FPastTicks)
  else
    FPastTicks := 0;
  if (FPastTicks >= TurnHoldTicks) and FArmed and (FFire = rfIdle) then
  begin
    FPastTicks := 0;
    FTurnTicks := TurnTicks;
    Exit;
  end;

  var Goal := FWant;
  var Rate := TrackRate;
  if FFire <> rfIdle then
    if FirePatterns[Tier].Hose then
      Rate := HoseRate
    else
    begin
      var Reached: Boolean;
      Goal := AimWithin(Bearing(Sleeve, FFrozenAt), FFacing, Reached) + FSway;
    end;
  FAim := FAim + EnsureRange(Goal - FAim, -Rate, Rate);
end;

// Rest, the lens burning red, the burst, rest again. A press holds the
// fire: no new burst, and a lens that burns goes out; a burst under way
// is let out.
procedure TRam.TickFire;
begin
  if FHead = rhBunker then
  begin
    TickHatch;
    Exit;
  end;
  if not CanShoot then
  begin
    if FFire <> rfIdle then
    begin
      FFire := rfIdle;
      FFireTicks := FirePatterns[Tier].RestTicks;
      if FHead = rhSweeper then
        FFireTicks := SweepPatterns[Tier].RestTicks;
    end;
    Exit;
  end;
  if FHead = rhSweeper then
  begin
    TickSweep;
    Exit;
  end;

  var Pattern := FirePatterns[Tier];
  case FFire of
    rfIdle:
      if FFireTicks > 0 then
        Dec(FFireTicks)
      else if not FPressing and FInSights and
        (Abs(FWant - FAim) <= AimSlack) then
      begin
        FFire := rfFlare;
        FFireTicks := Pattern.FlareTicks;
        FFrozenAt := FHeroCenter;
        if Pattern.Lead then
        begin
          // Where he will be when the bullet gets there, if he keeps going
          var Sleeve := HeadPoint(WellAt(FX), FMast, FSway, rhHunter, FFacing, 1,
            HunterSleeveX, HunterSleeveY);
          var Flight := Hypot(FHeroCenter.X - Sleeve.X,
            FHeroCenter.Y - Sleeve.Y) / HunterBulletSpeed + Pattern.FlareTicks;
          FFrozenAt := UnitPoint(
            FHeroCenter.X + EnsureRange(FHeroPace.X * Flight, -LeadMax, LeadMax),
            FHeroCenter.Y + EnsureRange(FHeroPace.Y * Flight, -LeadMax, LeadMax));
        end;
      end;
    rfFlare:
      if FPressing then
      begin
        FFire := rfIdle;
        FFireTicks := Pattern.RestTicks div 2;
      end
      else if FFireTicks > 1 then
        Dec(FFireTicks)
      else
      begin
        FFire := rfBurst;
        FShotsLeft := Pattern.Shots;
        FFireTicks := 0;
      end;
    rfBurst:
      if FFireTicks > 0 then
        Dec(FFireTicks)
      else
      begin
        Shoot;
        Dec(FShotsLeft);
        FFireTicks := Pattern.GapTicks;
        if FShotsLeft <= 0 then
        begin
          FFire := rfIdle;
          FFireTicks := Pattern.RestTicks;
        end;
      end;
  end;
end;

// A bullet out of the muzzle, along the barrel as the sway has it
procedure TRam.Shoot;
begin
  var Sleeve := HeadPoint(WellAt(FX), FMast, FSway, rhHunter, FFacing, 1,
    HunterSleeveX, HunterSleeveY);
  var Along := FAim - FSway;
  var Barrel := Heading(Along);
  var Reach := BarrelPivotX - BarrelMuzzleX;
  FCue.Shot := True;
  FCue.ShotFrom := UnitPoint(Sleeve.X + Barrel.X * Reach,
    Sleeve.Y + Barrel.Y * Reach);
  FCue.ShotAngle := Round(Along);
  FCue.ShotSpeed := HunterBulletSpeed;
end;

// The barrels' middle row on the screen with the mast at AMast, the sway
// left out
function TRam.SweeperRowY(AMast: Single): Single;
begin
  Result := RamTop + WellY - AMast - HeadShapes[rhSweeper].SocketY +
    (BarrelsTop + BarrelsBottom) / 2;
end;

function TRam.SweeperMastFor(ARowY: Single): Single;
begin
  Result := EnsureRange(RamTop + WellY - ARowY -
    HeadShapes[rhSweeper].SocketY + (BarrelsTop + BarrelsBottom) / 2,
    SweeperMastLowest, SweeperMastHighest);
end;

// Turns to a hero on its other side; idle, follows his row - the bottom
// of the mast while the ram presses him, the closed ceiling; a ladder
// rides its row through the sweep. The mast goes after the row.
procedure TRam.TickRide;
begin
  if not FArmed then
    Exit;
  var OtherSide := (FHeroCenter.X - WellAt(FX)) * -FFacing;
  if OtherSide > SweeperTurnPast then
    Inc(FPastTicks)
  else
    FPastTicks := 0;
  if (FPastTicks >= TurnHoldTicks) and (FFire = rfIdle) then
  begin
    FPastTicks := 0;
    FTurnTicks := TurnTicks;
    Exit;
  end;

  var Highest := SweeperRowY(SweeperMastHighest);
  var Lowest := SweeperRowY(SweeperMastLowest);
  case FFire of
    rfIdle:
      if FPressing then
        FRowY := Lowest
      else
        FRowY := FHeroCenter.Y;
    rfBurst:
      FRowY := FRowY + FLadderWay * LadderRate;
  end;
  FRowY := EnsureRange(FRowY, Highest, Lowest);
  var Goal := SweeperMastFor(FRowY);
  FMast := FMast + EnsureRange(Goal - FMast, -RideRate, RideRate);
end;

// Rest; on its row, with him in front, the barrels burn red; the sweep.
// The fork sweeps once more at once a row away; the ladder rides through
// its sweep toward the side with more room.
procedure TRam.TickSweep;
begin
  var Pattern := SweepPatterns[Tier];
  var OnRow := Abs(SweeperRowY(FMast) - FRowY) <= RowSlack;
  case FFire of
    rfIdle:
      if FFireTicks > 0 then
        Dec(FFireTicks)
      else if OnRow and
        ((FHeroCenter.X - WellAt(FX)) * -FFacing <= SweeperTurnPast) then
      begin
        FForkLeft := Pattern.Fork;
        BeginSweep(Pattern.HeatTicks);
      end;
    rfFlare:
      if not OnRow then
        Exit
      else if FFireTicks > 1 then
        Dec(FFireTicks)
      else
      begin
        FFire := rfBurst;
        FShotsLeft := Pattern.Shots;
        FFireTicks := 0;
        FLadderWay := 0;
        if Pattern.Ladder then
        begin
          FLadderWay := 1;
          if FRowY - SweeperRowY(SweeperMastHighest) >
            SweeperRowY(SweeperMastLowest) - FRowY then
            FLadderWay := -1;
        end;
      end;
    rfBurst:
      if FFireTicks > 0 then
        Dec(FFireTicks)
      else
      begin
        ShootBarrel;
        Dec(FShotsLeft);
        FFireTicks := Pattern.GapTicks;
        if FShotsLeft > 0 then
          Exit;
        FLadderWay := 0;
        if FForkLeft then
        begin
          FForkLeft := False;
          FRowY := ForkRow;
          BeginSweep(ForkHeatTicks);
        end
        else
        begin
          FFire := rfIdle;
          FFireTicks := Pattern.RestTicks;
        end;
      end;
  end;
end;

procedure TRam.BeginSweep(AFlareTicks: Integer);
begin
  FFire := rfFlare;
  FFireTicks := AFlareTicks;
  FHeatTicks := AFlareTicks;
end;

// A cell up - the jump is the way out of a row - or down when he is
// already falling, or when up is past the mast
function TRam.ForkRow: Single;
const
  Falling = 0.5;
begin
  var Way := -1;
  if FHeroPace.Y > Falling then
    Way := 1;
  Result := FRowY + Way * ForkStep;
  if (Result < SweeperRowY(SweeperMastHighest)) or
    (Result > SweeperRowY(SweeperMastLowest)) then
    Result := FRowY - Way * ForkStep;
end;

// Level out of the next of the four muzzles in turn
procedure TRam.ShootBarrel;
begin
  FCue.Shot := True;
  FCue.ShotFrom := HeadPoint(WellAt(FX), FMast, FSway, rhSweeper, FFacing, 1, MuzzleX,
    MuzzleYs[FNextBarrel]);
  FCue.ShotAngle := 180;
  if FFacing > 0 then
    FCue.ShotAngle := 0;
  FCue.ShotSpeed := SweeperBulletSpeed;
  FNextBarrel := (FNextBarrel + 1) mod Length(MuzzleYs);
end;

// Turns to a hero on its other side - only while it aims, never with the
// hatch open
procedure TRam.TickBunkerTurn;
begin
  if not FArmed then
    Exit;
  var OtherSide := (FHeroCenter.X - WellAt(FX)) * -FFacing;
  if OtherSide > SweeperTurnPast then
    Inc(FPastTicks)
  else
    FPastTicks := 0;
  if (FPastTicks >= TurnHoldTicks) and (FHatch = bhAiming) then
  begin
    FPastTicks := 0;
    FTurnTicks := TurnTicks;
  end;
end;

// Shut, it aims and lobs; a beat; the column; the window; shut again. A
// breath under way runs to its end; a new one waits for a hero to aim at,
// a head turned to him and its row lit - and for a fall back to be over.
procedure TRam.TickHatch;
begin
  if not FArmed or FHeadKilled then
  begin
    TickLid;
    Exit;
  end;
  case FHatch of
    bhAiming:
      if CanShoot and not Booting and not HoldsFire then
      begin
        if FHatchTicks > 0 then
          Dec(FHatchTicks)
        else
        begin
          Lob;
          FHatch := bhFired;
          FHatchTicks := HatchFiredTicks;
        end;
      end;
    bhFired:
      if FHatchTicks > 0 then
        Dec(FHatchTicks)
      else
      begin
        FHatch := bhVenting;
        FHatchTicks := HatchVentTicks;
        FCue.Vent := True;
      end;
    bhVenting:
      if FHatchTicks > 0 then
        Dec(FHatchTicks)
      else
      begin
        FHatch := bhOpen;
        FHatchTicks := HatchWindowTicks;
      end;
    bhOpen:
      if FHatchTicks > 0 then
        Dec(FHatchTicks)
      else
      begin
        FHatch := bhAiming;
        FHatchTicks := HatchAimTicks;
        if FHunt <> htNone then
          FHatchTicks := HuntAimTicks;
      end;
  end;
  TickLid;
end;

// The column throws the lid open at once; it shuts slower
procedure TRam.TickLid;
begin
  if (FHead = rhBunker) and FArmed and (FHatch in [bhVenting, bhOpen]) then
    FLid := Min(1, FLid + 1 / LidOpenTicks)
  else
    FLid := Max(0, FLid - 1 / LidShutTicks);
end;

// Out of the next of its two muzzles, at the hero's feet; in the second
// phase out of both, the other shell where the game says. In the hunt, at
// the pad he stands on, or else at the road under him.
procedure TRam.Lob;
begin
  FCue.Lob := True;
  FCue.LobAt := UnitPoint(FHeroCenter.X, FHero.Body.Y + FHero.Body.H);
  FCue.LobForRoad := (FHunt <> htNone) and not FHero.OnDeck;
  FCue.Jolt := Max(FCue.Jolt, LobJolt);
  if not BunkerSecondPhase then
  begin
    FCue.LobFrom := BunkerMuzzle(FNextMuzzle);
    FNextMuzzle := (FNextMuzzle + 1) mod Length(BunkerMuzzles);
    Exit;
  end;
  FCue.LobFrom := BunkerMuzzle(0);
  FCue.SecondLob := True;
  FCue.SecondLobFrom := BunkerMuzzle(1);
  FCue.SecondLobAt := FHero.SecondAt;
end;

function TRam.BunkerMuzzle(AIndex: Integer): TSdlFPoint;
begin
  var Muzzle := BunkerMuzzles[AIndex];
  Result := HeadPoint(WellAt(FX), FMast, FSway, rhBunker, FFacing, TurnSquash,
    Muzzle.X, Muzzle.Y);
end;

function TRam.BunkerSecondPhase: Boolean;
begin
  Result := (FHead = rhBunker) and FArmed and FChased and not FHeadKilled and
    (Tier = 1);
end;

function TRam.BunkerThirdPhase: Boolean;
begin
  Result := (FHead = rhBunker) and FArmed and FChased and not FHeadKilled and
    (Tier = 2);
end;

// At the wall it waits out the gap and the hatch's breath, warns and
// lunges; at the middle it stands, then drives back. The two drives end
// in Arrive.
procedure TRam.TickFallBack;
begin
  case FFallBack of
    fbNone:
      begin
        if not BunkerSecondPhase or not FHero.Alive then
          Exit;
        if FFallBackWait > 0 then
          Dec(FFallBackWait)
        else if FHatch = bhAiming then
        begin
          FFallBack := fbWarning;
          FFallBackTicks := 0;
        end;
      end;
    fbWarning:
      begin
        Inc(FFallBackTicks);
        if FFallBackTicks >= FallBackWarnTicks then
        begin
          FFallBack := fbLunging;
          BeginDrive(FallBackX, LungeSpeed, False);
        end;
      end;
    fbStanding:
      begin
        Inc(FFallBackTicks);
        if FFallBackTicks >= FallBackStandTicks then
        begin
          FFallBack := fbReturning;
          BeginDrive(ScreenWidth - RamWidth, ReturnSpeed, False);
        end;
      end;
  end;
end;

// One danger at a time: while it warns, lunges and stands, the bunker is
// silent; on its way back it aims again. From the change to the hunt till
// it is in again bow first it is silent too.
function TRam.HoldsFire: Boolean;
begin
  Result := (FFallBack in [fbWarning, fbLunging, fbStanding]) or
    (FHunt in [htCalling, htPassing, htTurning, htEntering]);
end;

function TRam.NextFallBackWait: Integer;
begin
  Result := FallBackEveryLeastTicks +
    Round(FDice.NextUnit * (FallBackEveryMostTicks - FallBackEveryLeastTicks));
end;

function TRam.FallingBack: Boolean;
begin
  Result := FFallBack in [fbLunging, fbStanding, fbReturning];
end;

// The change begins where it stands, at the wall or at the middle: a fall
// back under way is over
procedure TRam.BeginHunt;
begin
  FHunt := htCalling;
  FHuntTicks := 0;
  FRowsIn := False;
  FFallBack := fbNone;
  FCue.Alarm := True;
  FCue.Rows := True;
end;

// The change: the eye blinks till the wave is in and a warning after;
// then the pass off the left edge, which ends in Arrive; the turn out
// there; the drive in again and the hunt
procedure TRam.TickHunt;
begin
  case FHunt of
    htNone:
      if BunkerThirdPhase then
        BeginHunt;
    htCalling:
      begin
        Inc(FHuntTicks);
        if FRowsIn and (FHuntTicks >= HuntPassWarnTicks) then
        begin
          FHunt := htPassing;
          BeginDrive(-RamWidth - PassBeyond, LungeSpeed, False);
        end;
      end;
    htTurning:
      begin
        Inc(FHuntTicks);
        if FHuntTicks >= HuntTurnTicks then
          FHunt := htEntering;
      end;
    htEntering, htHunting:
      TickHuntDrive;
    htBraking:
      TickBrake;
    htStunned:
      TickStun;
  end;
end;

// Off the screen it faces right from now on
procedure TRam.BeginTurn;
begin
  FHunt := htTurning;
  FHuntTicks := 0;
  FHullFacing := 1;
  FShield.Mirrored := True;
  BeginRest(0);
end;

// Where its left edge would put the bow a step behind him
function TRam.HuntMark: Single;
begin
  Result := EnsureRange(FHeroCenter.X - HuntTrail - RamWidth, 0,
    ScreenWidth - RamWidth);
end;

// Not of the world: the road does not carry it. Its bow a step behind the
// hero, a little faster than he runs; back only for one who has come down
// behind its stern - one on a pad there the road carries back over its
// hatch. After a ram it stands while he flies clear. It comes in from
// beyond the left edge at the lunge's pace, whole onto the screen.
procedure TRam.TickHuntDrive;
begin
  var OldSpeed := FSpeed;
  var Entering := FHunt = htEntering;
  var Mark := FX;
  if FHero.Alive then
    Mark := HuntMark;
  if Entering then
    Mark := Max(Mark, 0)
  else if FRamStandTicks > 0 then
  begin
    Dec(FRamStandTicks);
    Mark := FX;
  end;
  var Behind := FHero.Alive and not FHero.OnDeck and (FHeroCenter.X < FX);
  if not Behind then
    Mark := Max(Mark, FX);

  var Fastest: Single := HuntBehindSpeed;
  var Least: Single := 0;
  if Entering then
  begin
    Fastest := LungeSpeed;
    Least := FX;
  end
  else
  begin
    TickSurge;
    // Past its line it goes back to it, whoever is where - as fast as it
    // surged, so the right is pressed only for a breath
    var LineLeft: Single := HuntLine - RamWidth;
    Mark := Min(Mark, LineLeft);
    if (FSurge = hsSurging) or (FX > LineLeft) then
      Fastest := LungeSpeed;
  end;
  var Want: Single := EnsureRange((Mark - FX) * HuntGain, -Fastest, Fastest);
  FSpeed := EnsureRange(Want, FSpeed - Brake, FSpeed + Brake);
  var Next: Single := FX + FSpeed;
  FX := EnsureRange(Next, Least, ScreenWidth - RamWidth);
  if FX <> Next then
    FSpeed := 0;
  FAccel := FSpeed - OldSpeed;
  if Entering and (FX > -EnterSlop) then
  begin
    FHunt := htHunting;
    FSurge := hsWaiting;
    FSurgeTicks := NextSurgeWait;
  end;
end;

procedure TRam.TickSurge;
begin
  case FSurge of
    hsWaiting:
      begin
        Dec(FSurgeTicks);
        if FSurgeTicks <= 0 then
        begin
          FSurge := hsWarning;
          FSurgeTicks := 0;
        end;
      end;
    hsWarning:
      begin
        Inc(FSurgeTicks);
        if FSurgeTicks >= HuntSurgeWarnTicks then
        begin
          FSurge := hsSurging;
          FSurgeTicks := 0;
        end;
      end;
    hsSurging:
      begin
        Inc(FSurgeTicks);
        if FSurgeTicks >= HuntSurgeTicks then
        begin
          FSurge := hsWaiting;
          FSurgeTicks := NextSurgeWait;
        end;
      end;
  end;
end;

// By the brake of every stop, the lamps burning; at a stand the hiss and
// the jolt. A machine already standing stops this tick.
procedure TRam.TickBrake;
begin
  var OldSpeed := FSpeed;
  var Pace := Max(0, Abs(FSpeed) - Brake);
  FBraking := Pace > 0;
  FSpeed := Sign(FSpeed) * Pace;
  FX := EnsureRange(FX + FSpeed, 0, ScreenWidth - RamWidth);
  FAccel := FSpeed - OldSpeed;
  if FBraking then
    Exit;
  FHunt := htHalted;
  FLamps := 1;
  FLampHold := LampHoldTicks;
  FCue.Hiss := True;
  FCue.Jolt := HaltJolt;
end;

function TRam.CanBrake: Boolean;
begin
  Result := Present and (FHunt = htHunting);
end;

procedure TRam.BrakeToAStand;
begin
  if not CanBrake then
    Exit;
  FHunt := htBraking;
  FSurge := hsWaiting;
  FRamStandTicks := 0;
end;

function TRam.Halted: Boolean;
begin
  Result := FHunt in [htBraking, htHalted, htStunned];
end;

procedure TRam.Stun(const AFrom: TSdlFPoint);
begin
  if not (FHunt in [htBraking, htHalted]) then
    Exit;
  var Middle: Single := FX + RamWidth / 2;
  FStunSide := -FHullFacing;
  if AFrom.X > Middle then
    FStunSide := -1
  else if AFrom.X < Middle then
    FStunSide := 1;
  FHunt := htStunned;
  FHuntTicks := 0;
  FStunFrom := FX;
  FSpeed := 0;
  FBraking := False;
  FLampHold := 0;
  FFlickerTicks := 0;
  FWithdraw := Default(TRamWithdraw);
  FLightsAlarm := 0;
  FAlarmPhase := 0;
end;

function TRam.Stunned: Boolean;
begin
  Result := FHunt = htStunned;
end;

procedure TRam.LightsAlarm(ALevel: Single);
begin
  FLightsAlarm := EnsureRange(ALevel, 0, 1);
end;

// Lit for the first half of every blink; dark with no alarm
function TRam.AlarmLight: Single;
begin
  Result := 0;
  if (FLightsAlarm > 0) and (Frac(FAlarmPhase) < 0.5) then
    Result := 1;
end;

procedure TRam.Withdraw(ALeft: Single);
begin
  if FHunt <> htStunned then
    Exit;
  FWithdraw := Default(TRamWithdraw);
  FWithdraw.Asked := True;
  FWithdraw.Till := ALeft;
end;

// The engine starts where the throw has left it; at the end the brake's
// hiss
procedure TRam.TickWithdraw;
begin
  if not FWithdraw.Asked then
    Exit;
  if FWithdraw.Clock = 0 then
  begin
    FWithdraw.From := FX;
    FWithdraw.Ticks := Max(WithdrawLeastTicks,
      Ceil(Abs(FWithdraw.Till - FX) / WithdrawPace));
    FCue.Rumble := True;
  end;
  if FWithdraw.Clock >= FWithdraw.Ticks then
    Exit;
  Inc(FWithdraw.Clock);
  var OldSpeed := FSpeed;
  var Share: Single := FWithdraw.Clock / FWithdraw.Ticks;
  var Next: Single := FWithdraw.From +
    (FWithdraw.Till - FWithdraw.From) * Share * Share * (3 - 2 * Share);
  FSpeed := Next - FX;
  FX := Next;
  FAccel := FSpeed - OldSpeed;
  if FWithdraw.Clock < FWithdraw.Ticks then
    Exit;
  FSpeed := 0;
  FCue.Hiss := True;
end;

// Thrown off the road's grip: fast, slower, at rest half a cell on. The
// mast swings with the shove. Then the drive off, if one is asked for.
procedure TRam.TickStun;
begin
  if FHuntTicks >= StunThrowTicks then
  begin
    TickWithdraw;
    Exit;
  end;
  Inc(FHuntTicks);
  var OldSpeed := FSpeed;
  var Share: Single := FHuntTicks / StunThrowTicks;
  var Next: Single := FStunFrom + FStunSide * StunThrow * (1 - Sqr(1 - Share));
  FSpeed := Next - FX;
  FX := Next;
  FAccel := FSpeed - OldSpeed;
  if FHuntTicks = StunThrowTicks then
    FSpeed := 0;
end;

procedure TRam.ShedWheel;
begin
  if not Stunned or FShed then
    Exit;
  FShed := True;
  FShedTicks := 0;
  FWheel.Start(HullSpot(FX, Axles[FrontAxle]), WheelRadius);
end;

function TRam.WheelShed: Boolean;
begin
  Result := FShed;
end;

// The hull drops faster as it goes, to the side it faces, till it takes
// off; the wheels roll
procedure TRam.TickShed;
begin
  FWheel.Tick;
  HearStrike(FWheel);
  FRearWheel.Tick;
  HearStrike(FRearWheel);
  if not FShed then
    Exit;
  if FShedTicks < ScrapeTicks then
    Inc(FShedTicks);
  if FTakeoff.Running then
  begin
    TickTakeoff;
    Exit;
  end;
  var Share: Single := Min(FShedTicks / LeanTicks, 1);
  FLean := FHullFacing * LeanDegrees * Sqr(Share);
end;

procedure TRam.TakeOff;
begin
  if not FShed or FTakeoff.Running then
    Exit;
  FTakeoff.Start(FLean, FHullFacing);
end;

// Hanging, after the hero: over him, as far as the screen lets the hull be
procedure TRam.TickTakeoff;
begin
  var Toward: Single := 0;
  if FHeroSeen then
    Toward := EnsureRange(FHeroCenter.X, RamWidth / 2, ScreenWidth - RamWidth / 2) -
      (FX + RamWidth / 2);
  var Step := FTakeoff.Tick(Toward);
  FX := FX + FTakeoff.Pace;
  FLean := FTakeoff.LeanAt(1);
  if Step.Ignite then
  begin
    FCue.Ignite := True;
    FCue.Jolt := Max(FCue.Jolt, IgniteJolt);
  end;
  if Step.Spit then
  begin
    SpitWheel;
    FCue.Hover := True;
  end;
end;

procedure TRam.HearStrike(const AWheel: TLooseWheel);
begin
  var Strike := AWheel.Struck;
  if Strike <= 0 then
    Exit;
  if Strike >= WheelThumpStrike then
    FCue.WheelLands := True;
  FCue.Jolt := Max(FCue.Jolt, WheelStrikeTrauma * Min(Strike / WheelHardStrike, 1));
end;

// Out of its well where the pose has the rear axle now, down onto the road
// under the axle's spot upright
procedure TRam.SpitWheel;
begin
  FRearWheel.Drop(PoseSpot(PoseAt(1), Axles[RearAxle]), WheelRadius,
    HullSpot(FX, Axles[RearAxle]).Y);
end;

function TRam.LeanAt(AAlpha: Single): Single;
begin
  Result := Lerp(FLastLean, FLean, AAlpha);
end;

function TRam.ShutterAt(AAlpha: Single): Single;
begin
  Result := Lerp(FLastShutter, FShutter, AAlpha);
end;

procedure TRam.TickShutter;
begin
  if FShutting then
    FShutter := Min(FShutter + 1 / ShutterTicks, 1);
end;

function TRam.LeanPivot(ALeft: Single): TSdlFPoint;
var
  Touch: THullPoint;
begin
  Touch.X := Axles[RearAxle].X;
  Touch.Y := Axles[RearAxle].Y + WheelRadius;
  Result := HullSpot(ALeft, Touch);
end;

function TRamPose.Upright: Boolean;
begin
  Result := (Lean = 0) and (Shift.X = 0) and (Shift.Y = 0);
end;

// Off the road it comes to turn about its middle: a turn about its middle
// is the turn about the wheel's touch, moved by where that turn takes the
// middle
function TRam.PoseAt(AAlpha: Single): TRamPose;
begin
  Result.Left := LeftAt(AAlpha);
  Result.Lean := LeanAt(AAlpha);
  var Middle := UnitPoint(Result.Left + RamWidth / 2, RamTop + RamHeight / 2);
  var TurnedMiddle := Turned(Middle, LeanPivot(Result.Left), Result.Lean);
  var Air := FTakeoff.AirAt(AAlpha);
  Result.Shift.X := Air * (Middle.X - TurnedMiddle.X);
  Result.Shift.Y := Air * (Middle.Y - TurnedMiddle.Y) - FTakeoff.LiftAt(AAlpha);
end;

function TRam.Posed(const APose: TRamPose; const APoint: TSdlFPoint): TSdlFPoint;
begin
  if APose.Upright then
    Exit(APoint);
  Result := Turned(APoint, LeanPivot(APose.Left), APose.Lean);
  Result.X := Result.X + APose.Shift.X;
  Result.Y := Result.Y + APose.Shift.Y;
end;

function TRam.PoseSpot(const APose: TRamPose;
  const APoint: THullPoint): TSdlFPoint;
begin
  Result := Posed(APose, HullSpot(APose.Left, APoint));
end;

// The box the hero's corners make, brought back into the upright hull on
// the road: a little wider than the box itself while the hull leans
function TRam.UprightBox(const ABox: TSdlFRect): TSdlFRect;
begin
  var Pose := PoseAt(1);
  if Pose.Upright then
    Exit(ABox);
  var Pivot := LeanPivot(FX);
  var Least := UnitPoint(MaxSingle, MaxSingle);
  var Most := UnitPoint(-MaxSingle, -MaxSingle);
  for var Corner := 0 to 3 do
  begin
    var Spot := Turned(UnitPoint(ABox.X + ABox.W * (Corner mod 2) - Pose.Shift.X,
      ABox.Y + ABox.H * (Corner div 2) - Pose.Shift.Y), Pivot, -Pose.Lean);
    Least := UnitPoint(Min(Least.X, Spot.X), Min(Least.Y, Spot.Y));
    Most := UnitPoint(Max(Most.X, Spot.X), Max(Most.Y, Spot.Y));
  end;
  Result.X := Least.X;
  Result.Y := Least.Y;
  Result.W := Most.X - Least.X;
  Result.H := Most.Y - Least.Y;
end;

function TRam.ScrapeLevel: Single;
begin
  Result := 0;
  if FShed then
    Result := 1 - FShedTicks / ScrapeTicks;
end;

// The body is a grid of the upright hull: the stretch is brought back into
// it from where the pose puts the hull, and what it meets is posed again.
// The first solid cell met along it is traced back to the edge the bullet
// came in through, as a box of armour is.
function TRam.StrikeHull(const AFrom, ATo: TSdlFPoint; out AAt,
  ANormal: TSdlFPoint): Boolean;
const
  // Units between two looks along the stretch: finer than a cell
  LookStep = 0.5;
begin
  AAt := ATo;
  ANormal := UnitPoint(0, -1);
  if not Present or (FShield.State = sdUp) then
    Exit(False);
  var Pose := PoseAt(1);
  var Pivot := LeanPivot(FX);
  var From := Turned(UnitPoint(AFrom.X - Pose.Shift.X, AFrom.Y - Pose.Shift.Y),
    Pivot, -Pose.Lean);
  var Till := Turned(UnitPoint(ATo.X - Pose.Shift.X, ATo.Y - Pose.Shift.Y),
    Pivot, -Pose.Lean);
  var WayX: Single := Till.X - From.X;
  var WayY: Single := Till.Y - From.Y;
  var Looks := Max(1, Ceil(Hypot(WayX, WayY) / LookStep));
  for var i := 0 to Looks do
  begin
    var Share: Single := i / Looks;
    var Strike := Default(TStrike);
    Strike.X := From.X + WayX * Share;
    Strike.Y := From.Y + WayY * Share;
    var Col := Floor(Strike.X - FX);
    var Row := Floor(Strike.Y - RamTop);
    if not SolidAt(Col, Row) then
      Continue;
    var Cell: TSdlFRect;
    Cell.X := FX + Col;
    Cell.Y := RamTop + Row;
    Cell.W := 1;
    Cell.H := 1;
    Strike.SpeedX := WayX;
    Strike.SpeedY := WayY;
    TraceEntry(Strike, Cell);
    AAt := Posed(Pose, UnitPoint(Strike.X, Strike.Y));
    ANormal := Turned(UnitPoint(Strike.NormalX, Strike.NormalY),
      UnitPoint(0, 0), Pose.Lean);
    FHullHitTicks := 0;
    Exit(True);
  end;
  Result := False;
end;

function TRam.StrikeWheel(const AFrom, ATo: TSdlFPoint; out AAt,
  ANormal: TSdlFPoint): Boolean;
begin
  Result := FWheel.Strike(AFrom, ATo, AAt, ANormal) or
    FRearWheel.Strike(AFrom, ATo, AAt, ANormal);
  if Result then
    FHullHitTicks := 0;
end;

// Each nozzle a box of the upright hull under its axle, as far as it is
// out; the stretch brought back into the upright hull as StrikeHull brings
// it
function TRam.StrikeNozzles(const AFrom, ATo: TSdlFPoint; out AAt,
  ANormal: TSdlFPoint): Boolean;
const
  // Units between two looks along the stretch: finer than a nozzle's wall
  LookStep = 0.5;
var
  Boxes: array [TTakeoffJet] of TSdlFRect;
begin
  AAt := ATo;
  ANormal := UnitPoint(0, 1);
  var Shown := FTakeoff.NozzleAt(1);
  if not Present or (Shown <= 0) then
    Exit(False);
  for var Jet := Low(TTakeoffJet) to High(TTakeoffJet) do
  begin
    var Axle := HullSpot(FX, Axles[JetAxles[Jet]]);
    Boxes[Jet].X := Axle.X - NozzleWidth / 2;
    Boxes[Jet].Y := Axle.Y + NozzleHang;
    Boxes[Jet].W := NozzleWidth;
    Boxes[Jet].H := NozzleHeight * Shown;
  end;
  var Pose := PoseAt(1);
  var Pivot := LeanPivot(FX);
  var From := Turned(UnitPoint(AFrom.X - Pose.Shift.X, AFrom.Y - Pose.Shift.Y),
    Pivot, -Pose.Lean);
  var Till := Turned(UnitPoint(ATo.X - Pose.Shift.X, ATo.Y - Pose.Shift.Y),
    Pivot, -Pose.Lean);
  var WayX: Single := Till.X - From.X;
  var WayY: Single := Till.Y - From.Y;
  var Looks := Max(1, Ceil(Hypot(WayX, WayY) / LookStep));
  for var i := 0 to Looks do
  begin
    var Share: Single := i / Looks;
    var Strike := Default(TStrike);
    Strike.X := From.X + WayX * Share;
    Strike.Y := From.Y + WayY * Share;
    for var Box in Boxes do
    begin
      var Inside := (Strike.X >= Box.X) and (Strike.X < Box.X + Box.W) and
        (Strike.Y >= Box.Y) and (Strike.Y < Box.Y + Box.H);
      if not Inside then
        Continue;
      Strike.SpeedX := WayX;
      Strike.SpeedY := WayY;
      TraceEntry(Strike, Box);
      AAt := Posed(Pose, UnitPoint(Strike.X, Strike.Y));
      ANormal := Turned(UnitPoint(Strike.NormalX, Strike.NormalY),
        UnitPoint(0, 0), Pose.Lean);
      FHullHitTicks := 0;
      Exit(True);
    end;
  end;
  Result := False;
end;

function TRam.HullStruckWithin(ATicks: Integer): Boolean;
begin
  Result := FHullHitTicks <= ATicks;
end;

function TRam.InTheHull(const AHeroBody: TSdlFRect; out AAway: Integer): Boolean;
begin
  AAway := 0;
  Result := Present and Overlaps(AHeroBody);
  if Result then
    AAway := ThrowSide(AHeroBody);
end;

function TRam.SurgeWarns: Boolean;
begin
  Result := (FHunt = htHunting) and (FSurge = hsWarning);
end;

// How far right its bow may go now
function TRam.HuntLine: Single;
begin
  Result := HuntMiddleLine;
  if FSurge = hsSurging then
    Result := HuntFarLine;
end;

function TRam.NextSurgeWait: Integer;
begin
  Result := HuntSurgeEveryLeastTicks + Round(FDice.NextUnit *
    (HuntSurgeEveryMostTicks - HuntSurgeEveryLeastTicks));
end;

function TRam.Hunts: Boolean;
begin
  Result := FHunt <> htNone;
end;

function TRam.PeekLevel: Single;
begin
  if FHunt <> htTurning then
    Exit(0);
  Result := EnsureRange((FHuntTicks - (HuntTurnTicks - HuntPeekTicks)) /
    HuntPeekTicks, 0.0, 1.0);
end;

function TRam.HullMirrored: Boolean;
begin
  Result := FHullFacing > 0;
end;

function TRam.WellAt(ALeft: Single): Single;
begin
  Result := HullSpot(ALeft, WellPoint).X;
end;

function TRam.HullSpot(ALeft: Single; const APoint: THullPoint): TSdlFPoint;
begin
  var Across := APoint.X;
  if HullMirrored then
    Across := RamWidth - Across;
  Result := UnitPoint(ALeft + Across, RamTop + APoint.Y);
end;

procedure TRam.RowsArrived;
begin
  if FHunt <> htCalling then
    Exit;
  FRowsIn := True;
  FHuntTicks := 0;
end;

function TRam.BunkerMiddle: TSdlFPoint;
begin
  var Shape := HeadShapes[rhBunker];
  Result := HeadPoint(WellAt(FX), FMast, FSway, rhBunker, FFacing, TurnSquash,
    Shape.Width / 2, Shape.Height / 2);
end;

function TRam.HatchPoint: TSdlFPoint;
begin
  Result := HeadPoint(WellAt(FX), FMast, FSway, rhBunker, FFacing, TurnSquash,
    HatchX, HatchY);
end;

function TRam.OpenTop: TSdlFPoint;
begin
  Result := HeadPoint(WellAt(FX), FMast, FSway, rhBunker, FFacing, TurnSquash,
    HatchX, HatchY + OpenRowsDepth);
end;

// Onto the top - the dome over the line where the honeycomb begins, or the
// lid: a steep enough bullet takes a life; a shallow one only flares the
// honeycomb. Under that line the honeycomb takes it, on the sides and the
// front.
function TRam.StrikeBunker(const AFrom, ATo: TSdlFPoint; out AAt: TSdlFPoint;
  out AGuarded: Boolean): Boolean;
begin
  AAt := ATo;
  AGuarded := False;
  if not Present or (FHead <> rhBunker) or not FArmed or FHeadKilled or
    (TurnSquash < ThinHeadSquash) then
    Exit(False);
  var Fall := ATo.Y - AFrom.Y;
  var Middle := BunkerMiddle;
  var Share: Single;
  if TopShare(AFrom, ATo, Share) then
  begin
    AAt := UnitPoint(Lerp(AFrom.X, ATo.X, Share), Lerp(AFrom.Y, ATo.Y, Share));
    var Steep := (Fall > 0) and
      (Fall >= Abs(ATo.X - AFrom.X) * Tan(DegToRad(HatchFallLeast)));
    if Steep then
    begin
      FHurtTicks := HurtFlashTicks;
      FHitTicks := 0;
      Dec(FLives);
      if FLives <= 0 then
        FHeadKilled := True;
      Exit(True);
    end;
    AGuarded := True;
    FHeadShield.Strike(UnitPoint(AAt.X - Middle.X, AAt.Y - Middle.Y));
    Exit(True);
  end;

  // Only the part of the stretch under the rim line meets the honeycomb
  var Opening := OpenTop;
  var From := AFrom;
  var Till := ATo;
  if (From.Y < Opening.Y) and (Till.Y < Opening.Y) then
    Exit(False);
  if (From.Y < Opening.Y) or (Till.Y < Opening.Y) then
  begin
    var Rim := UnitPoint(Lerp(AFrom.X, ATo.X, (Opening.Y - AFrom.Y) / Fall),
      Opening.Y);
    if From.Y < Opening.Y then
      From := Rim
    else
      Till := Rim;
  end;
  var Entry: TSdlFPoint;
  if not FHeadShield.TryEntry(UnitPoint(From.X - Middle.X, From.Y - Middle.Y),
    UnitPoint(Till.X - Middle.X, Till.Y - Middle.Y), Entry) then
    Exit(False);
  AGuarded := True;
  AAt := UnitPoint(Middle.X + Entry.X, Middle.Y + Entry.Y);
  FHeadShield.Strike(Entry);
  Result := True;
end;

function TRam.ColumnHolds(const ABody: TSdlFRect): Boolean;
begin
  if not Present or (FHead <> rhBunker) or (FHatch <> bhVenting) then
    Exit(False);
  var Opening := HatchPoint;
  Result := (ABody.X < Opening.X + ColumnHalfWidth) and
    (ABody.X + ABody.W > Opening.X - ColumnHalfWidth) and
    (ABody.Y < Opening.Y) and (ABody.Y + ABody.H > Opening.Y - ColumnHeight);
end;

function TRam.LidAt(AAlpha: Single): Single;
begin
  Result := Lerp(FLastLid, FLid, AAlpha);
end;

procedure TRam.WoundThird;
begin
  if (FHead = rhNone) or not FArmed or FHeadKilled then
    Exit;
  FLives := Max(0, FLives - Max(1, FFullLives div 3));
  FHurtTicks := HurtFlashTicks;
  FHitTicks := 0;
  if FLives > 0 then
    Exit;
  FHeadKilled := True;
  if FHead = rhSweeper then
    FRetreating := True;
end;

procedure TRam.TickHeat;
begin
  FHeat := 0;
  if (FHead <> rhSweeper) or not FArmed then
    Exit;
  if FRetreating then
  begin
    FHeat := Lerp(RetreatHeatLow, 1,
      0.5 - 0.5 * Cos(2 * Pi * FRetreatTicks / RetreatThrobTicks));
    Exit;
  end;
  case FFire of
    rfFlare:
      FHeat := Lerp(HeatFrom, 1, 1 - FFireTicks / FHeatTicks);
    rfBurst:
      FHeat := 1;
  end;
end;

procedure TRam.TickLamps;
begin
  if FHunt = htStunned then
  begin
    if FLightsAlarm > 0 then
      FAlarmPhase := FAlarmPhase + 1 / Lerp(AlarmBlinkSlow, AlarmBlinkFast, FLightsAlarm);
    FLamps := AlarmLight;
  end
  else if FBraking then
    FLamps := 1
  else if FLampHold > 0 then
    Dec(FLampHold)
  else
    FLamps := Max(0, FLamps - LampFade);
end;

// Lit, it breathes; while a head rises, through a change of heads, through
// the sweeper's end, before the bunker's fall back, through the change to
// its hunt and as it turns round off the screen, it blinks - the warning
procedure TRam.TickEye;
begin
  if not FEyeLit then
    FEye := 0
  else if (FHunt = htStunned) and (FLightsAlarm > 0) then
    FEye := Max(EyeBlinkLow, AlarmLight)
  else if FHunt = htStunned then
    FlickerEye
  else if (FPhase in [rpRising, rpChanging]) or FRetreating or Overloading or
    (FFallBack = fbWarning) or (FHunt in [htCalling, htTurning]) or
    SurgeWarns then
  begin
    var Clock := FPhaseTicks;
    if FRetreating then
      Clock := FRetreatTicks
    else if Overloading then
      Clock := FOverloadTicks
    else if FFallBack = fbWarning then
      Clock := FFallBackTicks
    else if FHunt in [htCalling, htTurning] then
      Clock := FHuntTicks
    else if SurgeWarns then
      Clock := FSurgeTicks;
    FEye := EyeBlinkLow;
    if (Clock div EyeBlinkTicks) mod 2 = 0 then
      FEye := 1;
  end
  else
  begin
    var Breath: Single := 0.5 - 0.5 * Cos(2 * Pi * FBreathTicks / EyeBreathTicks);
    FEye := Lerp(EyeBreathLow, EyeBreathHigh, Breath);
    Inc(FBreathTicks);
  end;
end;

// A level the dice pick, held as long as they say: a dark one, or one
// from its breath up to a flash
procedure TRam.FlickerEye;
begin
  if FFlickerTicks > 0 then
  begin
    Dec(FFlickerTicks);
    Exit;
  end;
  FFlickerTicks := StunFlickerLeast +
    Trunc(FDice.NextUnit * (StunFlickerMost - StunFlickerLeast + 1));
  if FDice.NextUnit < StunDarkShare then
    FEye := EyeBlinkLow
  else
    FEye := Lerp(EyeBreathLow, 1, FDice.NextUnit);
end;

// The first wink comes the tick the head locks. The lens burns red,
// brighter and brighter, before a burst and through it - the warning
// comes first, a struck eye only flashes when the lens is not burning.
procedure TRam.TickLens;
begin
  FLensHot := False;
  var Struck := FHurtTicks > 0;
  if Struck then
    Dec(FHurtTicks);
  if not FArmed or (FHead <> rhHunter) then
  begin
    FLens := 0;
    Exit;
  end;
  // The row comes up: the eye burns white with it - this is what has lives
  if RowLit < HeadRowCells then
  begin
    FLens := 1;
    Exit;
  end;
  case FFire of
    rfFlare:
      begin
        FLensHot := True;
        FLens := Lerp(LensFlareFrom, 1,
          1 - FFireTicks / FirePatterns[Tier].FlareTicks);
        Exit;
      end;
    rfBurst:
      begin
        FLensHot := True;
        FLens := 1;
        Exit;
      end;
  end;
  if Struck then
  begin
    FLens := 1;
    Exit;
  end;
  FLens := LensEmber;
  if FArmedTicks mod LensPeriodTicks < LensWinkTicks then
    FLens := 1;
  Inc(FArmedTicks);
end;

function TRam.Overlaps(const ABox: TSdlFRect): Boolean;
begin
  var Box := UprightBox(ABox);
  var FirstCol := Floor(Box.X - FX);
  var LastCol := Ceil(Box.X + Box.W - FX) - 1;
  var FirstRow := Floor(Box.Y - RamTop);
  var LastRow := Ceil(Box.Y + Box.H - RamTop) - 1;
  for var Row := Max(FirstRow, 0) to Min(LastRow, FBody.Height - 1) do
    for var Col := Max(FirstCol, 0) to Min(LastCol, FBody.Width - 1) do
      if SolidAt(Col, Row) then
        Exit(True);
  Result := False;
end;

// The body at ACol from the hull's left edge on the screen, turned round
// or not
function TRam.SolidAt(ACol, ARow: Integer): Boolean;
begin
  var Col := ACol;
  if HullMirrored then
    Col := FBody.Width - 1 - ACol;
  Result := FBody.At(Col, ARow) and not (FWells.At(Col, ARow) and WellOpen(Col));
end;

// The arch nearer the column of the art has lost its wheel, and no bay has
// come out into it yet
function TRam.WellOpen(AArtCol: Integer): Boolean;
begin
  var Middle := AArtCol + 0.5;
  var Shed := FShed;
  if Abs(Middle - Axles[RearAxle].X) < Abs(Middle - Axles[FrontAxle].X) then
    Shed := FTakeoff.Spat;
  Result := Shed and (FTakeoff.BayAt(1) < BayHolds);
end;

// The columns of the body that the rows of ABox meet, the whole width of
// the hull; False when the box is above or below it
function TRam.SpanAcross(const ABox: TSdlFRect; out AFirst,
  ALast: Integer): Boolean;
begin
  AFirst := FBody.Width;
  ALast := -1;
  var Box := UprightBox(ABox);
  var FirstRow := Max(Floor(Box.Y - RamTop), 0);
  var LastRow := Min(Ceil(Box.Y + Box.H - RamTop) - 1, FBody.Height - 1);
  for var Row := FirstRow to LastRow do
    for var Col := 0 to FBody.Width - 1 do
      if SolidAt(Col, Row) then
      begin
        AFirst := Min(AFirst, Col);
        ALast := Max(ALast, Col);
      end;
  Result := ALast >= 0;
end;

// Away from the middle - but straight up when that side leaves less room
// to the wall than his body needs: a throw into the wall would land him
// in the hull again, and again, while it stands there
function TRam.ThrowSide(const AHeroBody: TSdlFRect): Integer;
begin
  Result := 1;
  if AHeroBody.X + AHeroBody.W / 2 < FX + RamWidth / 2 then
    Result := -1;
  var First, Last: Integer;
  if not SpanAcross(AHeroBody, First, Last) then
    Exit;
  var Room: Single := FX + First;
  if Result > 0 then
    Room := ScreenWidth - (FX + Last + 1);
  if Room < AHeroBody.W then
    Result := 0;
end;

function TRam.Contact(const AHeroBody: TSdlFRect; AOnDeck, AInAir: Boolean;
  out AAway: Integer): Boolean;
begin
  AAway := 0;
  // Halted, it is a scene, till its wheel comes off
  if Halted and not FShed then
    Exit(False);
  if FHeroThrown and AInAir then
    Exit(False);
  FHeroThrown := False;
  if not Present or not Overlaps(AHeroBody) then
  begin
    FHeroInFront := False;
    FClearTicks := 0;
    Exit(False);
  end;
  if FClearTicks > 0 then
    Exit(False);
  // From the pass on a touch on the road is a throw over the hull, and in
  // the air or on a pad there is none
  if FHunt in [htPassing..htHunting] then
    Exit(False);
  if AOnDeck then
  begin
    FHeroInFront := True;
    Exit(False);
  end;
  if FHeroInFront and AInAir then
    Exit(False);

  FHeroInFront := False;
  FHeroThrown := True;
  FClearTicks := ClearTicks;
  AAway := ThrowSide(AHeroBody);
  Result := True;
end;

function TRam.ThrowsOverTheHull(const AHeroBody: TSdlFRect; AOnRoad: Boolean;
  out AThrow: TOverTheHull): Boolean;
begin
  AThrow := Default(TOverTheHull);
  if not Present or not AOnRoad or FHeroThrown or Halted then
    Exit(False);
  if FHunt in [htPassing..htHunting] then
  begin
    if (FClearTicks > 0) or not Overlaps(AHeroBody) then
      Exit(False);
    // To the right, his side: in the pass the hull drives on left under
    // him, in the hunt its bow keeps a step behind him, short of the wall
    AThrow.Side := 1;
    AThrow.Way := HuntFlingWay;
    FRamStandTicks := RamStandTicks;
  end
  else
  begin
    if not FallingBack or (AHeroBody.X + AHeroBody.W / 2 <= FX + RamWidth) then
      Exit(False);
    AThrow.Side := -1;
    AThrow.Way := FallBackFlingWay;
  end;
  FHeroInFront := False;
  FHeroThrown := True;
  FClearTicks := ClearTicks;
  Result := True;
end;

function TRam.Block(const AFrom, ATo: TSdlFPoint; out AAt: TSdlFPoint): Boolean;
begin
  AAt := ATo;
  if not Present then
    Exit(False);
  var MiddleX := FX + FBody.Middle.X;
  var MiddleY := RamTop + FBody.Middle.Y;
  var From: TSdlFPoint;
  From.X := AFrom.X - MiddleX;
  From.Y := AFrom.Y - MiddleY;
  var Till: TSdlFPoint;
  Till.X := ATo.X - MiddleX;
  Till.Y := ATo.Y - MiddleY;
  var Entry: TSdlFPoint;
  Result := FShield.TryEntry(From, Till, Entry);
  if not Result then
    Exit;
  FShield.Strike(Entry);
  AAt.X := MiddleX + Entry.X;
  AAt.Y := MiddleY + Entry.Y;
end;

// From the middle of the hull, as the shield has its points
procedure TRam.ShatterShield(const AAt: TSdlFPoint);
begin
  FShield.Shatter(UnitPoint(AAt.X - (FX + FBody.Middle.X),
    AAt.Y - (RamTop + FBody.Middle.Y)));
end;

function TRam.LensPoint: TSdlFPoint;
begin
  Result := HeadPoint(WellAt(FX), FMast, FSway, rhHunter, FFacing, TurnSquash,
    HunterLensX, HunterLensY);
end;

// The first point of the stretch on the eye or on the top, whichever it
// meets first. Only a hunter up and locked has them to hit.
function TRam.StrikeHunter(const AFrom, ATo: TSdlFPoint;
  out AAt: TSdlFPoint): Boolean;
begin
  AAt := ATo;
  if not Present or (FHead <> rhHunter) or not FArmed or FHeadKilled then
    Exit(False);
  var EyeAt: Single;
  var MeetsEye := EyeShare(AFrom, ATo, EyeAt);
  var TopAt: Single;
  var MeetsTop := TopShare(AFrom, ATo, TopAt);
  if not MeetsEye and not MeetsTop then
    Exit(False);
  var Share := EyeAt;
  if not MeetsEye then
    Share := TopAt
  else if MeetsTop then
    Share := Min(EyeAt, TopAt);
  AAt := UnitPoint(Lerp(AFrom.X, ATo.X, Share), Lerp(AFrom.Y, ATo.Y, Share));
  FHurtTicks := HurtFlashTicks;
  FHitTicks := 0;
  Dec(FLives);
  if FLives <= 0 then
    FHeadKilled := True;
  Result := True;
end;

// The stretch against a circle about the lens: the share of it where it
// first is within the circle
function TRam.EyeShare(const AFrom, ATo: TSdlFPoint; out AShare: Single): Boolean;
begin
  AShare := 0;
  var Lens := LensPoint;
  var AlongX := ATo.X - AFrom.X;
  var AlongY := ATo.Y - AFrom.Y;
  var FromX := AFrom.X - Lens.X;
  var FromY := AFrom.Y - Lens.Y;
  // |From + Along t| = EyeRadius, the smaller t in 0..1
  var A := Sqr(AlongX) + Sqr(AlongY);
  var B := 2 * (FromX * AlongX + FromY * AlongY);
  var C := Sqr(FromX) + Sqr(FromY) - Sqr(EyeRadius);
  if C <= 0 then
    Exit(True);
  var Discriminant := Sqr(B) - 4 * A * C;
  if (A = 0) or (Discriminant < 0) then
    Exit(False);
  AShare := (-B - Sqrt(Discriminant)) / (2 * A);
  Result := InRange(AShare, 0, 1);
end;

// The share of the stretch where it first comes onto the top of the head
// on the mast, from above or from the side. A climbing bullet that crosses
// the top's lower line into it comes up through the head and meets the
// top from inside: no share. A turn this far squashed leaves no top.
function TRam.TopShare(const AFrom, ATo: TSdlFPoint; out AShare: Single): Boolean;
begin
  AShare := 0;
  if TurnSquash < ThinHeadSquash then
    Exit(False);
  var From := ToHead(AFrom);
  var Till := ToHead(ATo);
  var Climbs := Till.Y < From.Y;
  var Line := TopLine;
  var Steps := Max(1, Ceil(Hypot(Till.X - From.X, Till.Y - From.Y) / StrikeStep));
  var Before := From;
  for var i := 0 to Steps do
  begin
    var Point := UnitPoint(Lerp(From.X, Till.X, i / Steps),
      Lerp(From.Y, Till.Y, i / Steps));
    if InTop(Point) then
    begin
      var FromInside := (i = 0) or (Before.Y > Line);
      if Climbs and FromInside then
        Exit(False);
      AShare := i / Steps;
      Exit(True);
    end;
    Before := Point;
  end;
  Result := False;
end;

// The lower line of the top in the head's own units: the hunter's lens,
// the bunker's row of cells under the hatch
function TRam.TopLine: Single;
begin
  if FHead = rhBunker then
    Result := HatchY + OpenRowsDepth
  else
    Result := HunterLensY;
end;

// A point in the head's own units on its top
function TRam.InTop(const ALocal: TSdlFPoint): Boolean;
begin
  case FHead of
    rhHunter:
      begin
        var Edge: Single;
        Result := OutlineAt(HunterTop, ALocal.X, Edge) and
          InRange(ALocal.Y, Edge, TopLine);
      end;
    rhBunker:
      Result := InDome(ALocal) or InLid(ALocal);
  else
    Result := False;
  end;
end;

function TRam.InDome(const ALocal: TSdlFPoint): Boolean;
begin
  var Edge: Single;
  Result := OutlineAt(DomeTop, ALocal.X, Edge) and (ALocal.Y >= Edge) and
    (ALocal.Y < TopLine);
end;

// The lid as it stands now, its turn and its way undone to where it lies
// shut, as DrawLid moves it: on the art as drawn facing right
function TRam.InLid(const ALocal: TSdlFPoint): Boolean;
begin
  var Shape := HeadShapes[rhBunker];
  var Shut := 1 - FLid;
  var Moved := UnitPoint(Shape.Width - ALocal.X - LidShutShift.X * Shut,
    ALocal.Y - LidShutShift.Y * Shut);
  var Hinge := UnitPoint(LidHinge.X, LidHinge.Y);
  var Lying := Turned(Moved, Hinge, -LidShutTurn * FLid);
  Lying := UnitPoint(Lying.X + LidShutShift.X, Lying.Y + LidShutShift.Y);
  var Upper: Single;
  var Lower: Single;
  Result := OutlineAt(LidTop, Lying.X, Upper) and
    OutlineAt(LidBottom, Lying.X, Lower) and InRange(Lying.Y, Upper, Lower);
end;

// A point of the screen in the own units of the head on the mast, as its
// art is drawn facing left: the sway, the facing and the squash of a turn
// undone
function TRam.ToHead(const APoint: TSdlFPoint): TSdlFPoint;
begin
  var Shape := HeadShapes[FHead];
  var Pivot := MastPivot(WellAt(FX));
  var Upright := Turned(APoint, Pivot, -FSway);
  Result := UnitPoint(Shape.SocketX - (Upright.X - Pivot.X) / (FFacing * TurnSquash),
    Upright.Y - Pivot.Y + FMast + Shape.SocketY);
end;

// The first point of the stretch on the pack or under it. Under it, or
// climbing into it, the bullet comes from below: a plate takes it.
function TRam.StrikeBarrels(const AFrom, ATo: TSdlFPoint; out AAt: TSdlFPoint;
  out AGuarded: Boolean): Boolean;
begin
  AAt := ATo;
  AGuarded := False;
  if not Present or (FHead <> rhSweeper) or not FArmed or FHeadKilled or
    (TurnSquash < ThinHeadSquash) then
    Exit(False);
  var From := ToHead(AFrom);
  var Till := ToHead(ATo);
  var Steps := Max(1, Ceil(Hypot(Till.X - From.X, Till.Y - From.Y) / StrikeStep));
  var Met := -1;
  var Under := False;
  for var i := 0 to Steps do
  begin
    var Point := UnitPoint(Lerp(From.X, Till.X, i / Steps),
      Lerp(From.Y, Till.Y, i / Steps));
    if not InRange(Point.X, BarrelsLeft, BarrelsRight) or
      not InRange(Point.Y, BarrelsTop, PlateBottom) then
      Continue;
    Met := i;
    Under := Point.Y > BarrelsBottom;
    Break;
  end;
  if Met < 0 then
    Exit(False);

  AAt := UnitPoint(Lerp(AFrom.X, ATo.X, Met / Steps),
    Lerp(AFrom.Y, ATo.Y, Met / Steps));
  var Climbs := AFrom.Y - ATo.Y > Abs(ATo.X - AFrom.X) * Tan(DegToRad(PlateCover));
  if Under or Climbs then
  begin
    AGuarded := True;
    var Local := ToHead(AAt);
    var Nearest := 0;
    if Abs(Local.X - PlateMiddles[1].X) < Abs(Local.X - PlateMiddles[0].X) then
      Nearest := 1;
    FPlates[Nearest].Strike(UnitPoint(
      -FFacing * (Local.X - PlateMiddles[Nearest].X) * TurnSquash, 0));
    Exit(True);
  end;

  FHurtTicks := HurtFlashTicks;
  FHitTicks := 0;
  Dec(FLives);
  if FLives <= 0 then
  begin
    FHeadKilled := True;
    FRetreating := True;
  end;
  Result := True;
end;

function TRam.BarrelsPoint: TSdlFPoint;
begin
  Result := HeadPoint(WellAt(FX), FMast, FSway, rhSweeper, FFacing, TurnSquash,
    (BarrelsLeft + BarrelsRight) / 2, (BarrelsTop + BarrelsBottom) / 2);
end;

function TRam.Plate(AIndex: Integer): TTekShield;
begin
  Result := FPlates[AIndex];
end;

function TRam.HeatAt(AAlpha: Single): Single;
begin
  Result := Lerp(FLastHeat, FHeat, AAlpha);
end;

function TRam.Booting: Boolean;
begin
  Result := (FHead <> rhNone) and FArmed and (RowLit < HeadRowCells);
end;

function TRam.AimAt(AAlpha: Single): Single;
begin
  Result := Lerp(FLastAim, FAim, AAlpha);
end;

function TRam.TurnSquash: Single;
begin
  Result := 1;
  if FTurnTicks > 0 then
    Result := Abs(2 * FTurnTicks / TurnTicks - 1);
end;

function TRam.Wounded: Boolean;
begin
  Result := (FHead = rhHunter) and (Tier = 2);
end;

function TRam.Overloading: Boolean;
begin
  Result := FHeadKilled and (FHead = rhSweeper) and not FRetreating;
end;

function TRam.Overload: Single;
begin
  Result := 0;
  if Overloading then
    Result := FOverloadTicks / OverloadTicks;
end;

function TRam.FlashAt(AAlpha: Single): Single;
begin
  Result := Lerp(FLastFlash, FFlash, AAlpha);
end;

function TRam.WaveFrontAt(AAlpha: Single): Single;
begin
  if not FWave.Running then
    Exit(NoWave);
  Result := FWave.FrontOf(FWave.Ticks - 1 + AAlpha);
end;

function TRam.WaveReaches(const APoint: TSdlFPoint): Boolean;
begin
  Result := FWave.Running and (Hypot(APoint.X - FBlastAt.X,
    APoint.Y - FBlastAt.Y) <= FWave.FrontOf(FWave.Ticks));
end;

// Away from the hull; from over it, toward the side with more road
function TRam.WaveSide(const AHeroBody: TSdlFRect): Integer;
begin
  var Middle := AHeroBody.X + AHeroBody.W / 2;
  if Middle < FX then
    Exit(-1);
  if Middle > FX + RamWidth then
    Exit(1);
  Result := 1;
  if FX > ScreenWidth - (FX + RamWidth) then
    Result := -1;
end;

function TRam.WaveStrikes(const AHeroBody: TSdlFRect;
  out AAway: Integer): Boolean;
begin
  AAway := 0;
  if FWave.Threw or not WaveReaches(UnitPoint(AHeroBody.X + AHeroBody.W / 2,
    AHeroBody.Y + AHeroBody.H / 2)) then
    Exit(False);
  FWave.Threw := True;
  FHeroThrown := True;
  FHeroInFront := False;
  FClearTicks := ClearTicks;
  AAway := WaveSide(AHeroBody);
  Result := True;
end;

function TRam.ShortLevel: Single;
begin
  if (FHead = rhNone) or not FArmed or (FLives * 2 > FFullLives) then
    Exit(0);
  Result := ShortFloor + ShortSpan * (1 - FLives * 2 / FFullLives);
end;

function TRam.Hurt: Boolean;
begin
  Result := FHurtTicks > 0;
end;

function TRam.LeftAt(AAlpha: Single): Single;
begin
  Result := Lerp(FLastX, FX, AAlpha);
end;

function TRam.MastAt(AAlpha: Single): Single;
begin
  Result := Lerp(FLastMast, FMast, AAlpha);
end;

function TRam.SwayAt(AAlpha: Single): Single;
begin
  Result := Lerp(FLastSway, FSway, AAlpha);
end;

function TRam.LampsAt(AAlpha: Single): Single;
begin
  Result := Lerp(FLastLamps, FLamps, AAlpha);
end;

function TRam.EyeAt(AAlpha: Single): Single;
begin
  Result := Lerp(FLastEye, FEye, AAlpha);
end;

function TRam.LensAt(AAlpha: Single): Single;
begin
  Result := Lerp(FLastLens, FLens, AAlpha);
end;

function TRam.Rolled: Single;
begin
  Result := FX - FLastX;
end;

// ---------------------------------------------------------------------------
// TRamArt
// ---------------------------------------------------------------------------

function ReadArtSurface(const ASpriteSet: TSpriteSet;
  const AName: string): PSdlSurface;
begin
  var Loaded := LoadImageSurface(ASpriteSet, AName);
  if Loaded = nil then
    raise ESpriteError.CreateFmt(SRamArtFailed, [AName, SdlErrorText]);
  Result := SDL_ConvertSurfaceFormat(Loaded, SdlPixelFormatAbgr8888, 0);
  SDL_FreeSurface(Loaded);
  if Result = nil then
    raise ESpriteError.CreateFmt(SRamArtFailed, [AName, SdlErrorText]);
end;

// How opaque the art is at the middle of the unit ACol, ARow
function AlphaAt(ASurface: PSdlSurface; ACol, ARow: Integer): Byte;
type
  PPixelBytes = ^TPixelBytes;
  TPixelBytes = array [0..3] of Byte; // R,G,B,A of SdlPixelFormatAbgr8888
begin
  var PixelX := Min(Trunc((ACol + 0.5) * ASurface.W / RamWidth), ASurface.W - 1);
  var PixelY := Min(Trunc((ARow + 0.5) * ASurface.H / RamHeight), ASurface.H - 1);
  var Pixel := PPixelBytes(PByte(ASurface.Pixels) + PixelY * ASurface.Pitch +
    PixelX * SizeOf(TPixelBytes));
  Result := Pixel[3];
end;

function WithinWheel(ACol, ARow: Integer): Boolean;
begin
  for var Axle in Axles do
    if Sqr(ACol + 0.5 - Axle.X) + Sqr(ARow + 0.5 - Axle.Y) <=
      Sqr(WheelRadius) then
      Exit(True);
  Result := False;
end;

// The hull, the dark of its arches and the wheels: everything a touch
// meets
function ReadBody(const ASpriteSet: TSpriteSet): TShieldMask;
begin
  Result.Width := Round(RamWidth);
  Result.Height := Round(RamHeight);
  Result.Middle.X := RamWidth / 2;
  Result.Middle.Y := RamHeight / 2;
  SetLength(Result.Solid, Result.Width * Result.Height);
  var Hull := ReadArtSurface(ASpriteSet, 'hull');
  try
    var Chassis := ReadArtSurface(ASpriteSet, 'chassis');
    try
      SDL_LockSurface(Hull);
      SDL_LockSurface(Chassis);
      for var Row := 0 to Result.Height - 1 do
        for var Col := 0 to Result.Width - 1 do
          Result.Solid[Row * Result.Width + Col] :=
            (AlphaAt(Hull, Col, Row) >= BodyAlpha) or
            (AlphaAt(Chassis, Col, Row) >= BodyAlpha) or WithinWheel(Col, Row);
      SDL_UnlockSurface(Chassis);
      SDL_UnlockSurface(Hull);
    finally
      SDL_FreeSurface(Chassis);
    end;
  finally
    SDL_FreeSurface(Hull);
  end;
end;

// The wheels and the dark of their arches, where the hull is not: what a
// shed wheel leaves hollow
function ReadWells(const ASpriteSet: TSpriteSet): TShieldMask;
begin
  Result.Width := Round(RamWidth);
  Result.Height := Round(RamHeight);
  Result.Middle.X := RamWidth / 2;
  Result.Middle.Y := RamHeight / 2;
  SetLength(Result.Solid, Result.Width * Result.Height);
  var Hull := ReadArtSurface(ASpriteSet, 'hull');
  try
    var Chassis := ReadArtSurface(ASpriteSet, 'chassis');
    try
      SDL_LockSurface(Hull);
      SDL_LockSurface(Chassis);
      for var Row := 0 to Result.Height - 1 do
        for var Col := 0 to Result.Width - 1 do
        begin
          var InArch := (AlphaAt(Chassis, Col, Row) >= BodyAlpha) or
            WithinWheel(Col, Row);
          Result.Solid[Row * Result.Width + Col] := InArch and
            (AlphaAt(Hull, Col, Row) < BodyAlpha);
        end;
      SDL_UnlockSurface(Chassis);
      SDL_UnlockSurface(Hull);
    finally
      SDL_FreeSurface(Chassis);
    end;
  finally
    SDL_FreeSurface(Hull);
  end;
end;

// A flame along the texture's height, its mouth at the top: as wide as a
// nozzle's mouth there, swelling a little, then thinning to its tip;
// brightest at the mouth, down its middle
function CreateFlameShape(ARenderer: PSdlRenderer): PSdlTexture;
const
  MouthShare = 0.6;
  SwellAt = 0.25;
  // Typed: Power has three overloads
  Fade: Single = 1.4;
  Edge = 2.5;
begin
  var Image: TArray<Single>;
  SetLength(Image, FlameSideTexels * FlameLengthTexels);
  var Half: Single := FlameSideTexels / 2;
  for var Row := 0 to FlameLengthTexels - 1 do
  begin
    var Along: Single := (Row + 0.5) / FlameLengthTexels;
    var Rest: Single := 1 - Along;
    var Strength: Single := Power(Rest, Fade);
    var Radius: Single := (MouthShare + (1 - MouthShare) *
      SmoothStep(Along / SwellAt)) * Sqrt(1 - Sqr(Along));
    for var Col := 0 to FlameSideTexels - 1 do
    begin
      var Across := (Col + 0.5 - Half) / Half / Radius;
      Image[Row * FlameSideTexels + Col] := Strength * Exp(-Edge * Sqr(Across));
    end;
  end;
  Result := CreateGlowFromImage(ARenderer, Image, FlameSideTexels,
    FlameLengthTexels);
end;

// A ring just inside the edge of its square, soft both ways; blended, not
// added, so drawn black it darkens what lies under it
function CreateWaveBand(ARenderer: PSdlRenderer): PSdlTexture;
begin
  var Image: TArray<Single>;
  SetLength(Image, WaveBandSide * WaveBandSide);
  var Half := WaveBandSide / 2;
  for var Row := 0 to WaveBandSide - 1 do
    for var Col := 0 to WaveBandSide - 1 do
    begin
      var Off := (Hypot(Col + 0.5 - Half, Row + 0.5 - Half) / Half -
        WaveBandRadius) / WaveBandWidth;
      Image[Row * WaveBandSide + Col] := Exp(-Off * Off);
    end;
  Result := CreateGlowFromImage(ARenderer, Image, WaveBandSide, WaveBandSide);
  SDL_SetTextureBlendMode(Result, SdlBlendModeBlend);
end;

constructor TRamArt.Create(ARenderer: PSdlRenderer);
begin
  inherited Create;
  FRenderer := ARenderer;
  FSpriteSet := TSpriteSet.Create(SpriteSetsDir + RamSetName + '.mset');
  FCache := TSpriteCache.Create(ARenderer);
  FCache.DisableColorKey;
  FCache.EnableLinearFilter;
  FCache.AttachSpriteSet(FSpriteSet);
  FWell := FCache.Get('well');
  FShutter := FCache.Get('wellShutter');
  FBay := FCache.Get('engineBay');
  FNozzle := FCache.Get('engineNozzle');
  FNozzleLit := FCache.Get('engineNozzleLit');
  for var i := Low(FMasts) to High(FMasts) do
    FMasts[i] := FCache.Get('mast' + IntToStr(i));
  FHunter := FCache.Get('hunter');
  FHunterBarrel := FCache.Get('hunterBarrel');
  FSweeper := FCache.Get('sweeper');
  FSweeperHeat := FCache.Get('sweeperHeat');
  FBunker := FCache.Get('bunker');
  FBunkerLid := FCache.Get('bunkerLid');
  FHullArt := THullArt.Create(ARenderer, RamHullDef);
  FShield := TShieldArt.Create(ARenderer);
  FGlow := CreateGlowShape(ARenderer, gsPoint, GlowSide);
  FWaveBand := CreateWaveBand(ARenderer);
  FFlame := CreateFlameShape(ARenderer);
  FBody := ReadBody(FSpriteSet);
  FWells := ReadWells(FSpriteSet);
end;

// The cache before the set: it reads from the set, never the reverse
destructor TRamArt.Destroy;
begin
  if Assigned(FFlame) then
    SDL_DestroyTexture(FFlame);
  if Assigned(FWaveBand) then
    SDL_DestroyTexture(FWaveBand);
  if Assigned(FGlow) then
    SDL_DestroyTexture(FGlow);
  FShield.Free;
  FHullArt.Free;
  FCache.Free;
  FSpriteSet.Free;
  inherited;
end;

// ---------------------------------------------------------------------------
// TRamPainter
// ---------------------------------------------------------------------------

// The road of the arena, which the sparks of the scrape ring off
function UnderTheRoad(AX, AY: Single): Boolean;
begin
  Result := AY >= RamFloorY;
end;

constructor TRamPainter.Create(AArt: TRamArt; ARam: TRam);
begin
  inherited Create;
  FArt := AArt;
  FRam := ARam;
  // The hull's own eye stays dark: the Ram lights its eye itself, and
  // the hull's fades too slowly for a blink to read
  FHull := THull.Create(RamHullDef, AArt.FHullArt);
  FHull.Doze;
  var Placement := Default(TDynamicPlacement);
  Placement.Tint := ExhaustTint;
  for var Turned := False to True do
  begin
    var Look := ExhaustSmoke;
    if Turned then
      Look.Angle := 180 - Look.Angle;
    for var i := Low(ExhaustSeeds) to High(ExhaustSeeds) do
      FExhausts[Turned][i] := TSmoke.CreateLook(Placement, Look, ExhaustIdle,
        ExhaustSeeds[i]);
  end;
  FHeadSmoke := TSmoke.CreateLook(Placement, HeadSmokeLook, 0, HeadSmokeSeed);
  for var Head := Low(FShorts) to High(FShorts) do
    FShorts[Head] := TLightning.CreateLook(Default(TDynamicPlacement),
      HeadShorts[Head], 0, ShortSeeds[Head]);
  FOverloadShort := TLightning.CreateLook(Default(TDynamicPlacement),
    OverloadShortLook, 0, OverloadShortSeed);
  var ColumnPlacement := Default(TDynamicPlacement);
  ColumnPlacement.Tint := ColumnTint;
  FColumn := TSmoke.CreateLook(ColumnPlacement, ColumnLook, 0, ColumnSeed);
  var DustPlacement := Default(TDynamicPlacement);
  DustPlacement.Tint := WaveDustTint;
  for var i := Low(FWaveDust) to High(FWaveDust) do
    FWaveDust[i] := TSmoke.CreateLook(DustPlacement, WaveDustLook, 0,
      WaveDustSeeds[i]);
  for var i := Low(FArchSmoke) to High(FArchSmoke) do
    FArchSmoke[i] := TSmoke.CreateLook(Placement, ArchSmokeLook, 0,
      ArchSmokeSeeds[i]);
  FScrape := TSparkField.Create(ScrapeSparkLook, UnderTheRoad, ScrapeCapacity,
    ScrapeSeed);
  FWheelSparks := TSparkField.Create(ScrapeSparkLook, UnderTheRoad,
    WheelSparkCapacity, WheelSparkSeed);
  for var Jet := Low(TTakeoffJet) to High(TTakeoffJet) do
    FJetDust[Jet] := TSmoke.CreateLook(DustPlacement, JetDustLook, 1,
      JetDustSeeds[Jet]);
end;

destructor TRamPainter.Destroy;
begin
  for var Smoke in FJetDust do
    Smoke.Free;
  FWheelSparks.Free;
  FScrape.Free;
  for var Smoke in FArchSmoke do
    Smoke.Free;
  for var Dust in FWaveDust do
    Dust.Free;
  FColumn.Free;
  FOverloadShort.Free;
  for var Short in FShorts do
    Short.Free;
  FHeadSmoke.Free;
  for var Exhaust in FExhausts do
    Exhaust.Free;
  FHull.Free;
  inherited;
end;

procedure TRamPainter.Tick(ABeltShift: Single);
begin
  Inc(FAge);
  FHull.Tick(0, 0, FRam.Rolled + ABeltShift);
  TickArrival;
  TickExhausts(ABeltShift);
  TickHeadSmoke(ABeltShift);
  TickShorts;
  TickColumn(ABeltShift);
  TickWaveDust;
  TickArchSmoke(ABeltShift);
  TickScrape;
  TickWheelSparks;
  TickJets;
end;

// A machine come anew left nothing in the air
procedure TRamPainter.TickArrival;
begin
  if FRam.Arrivals = FArrivals then
    Exit;
  FArrivals := FRam.Arrivals;
  FExhaustDriving := False;
  for var Exhaust in FExhausts do
    Exhaust.Rewind;
  FHeadSmoking := False;
  FHeadSmoke.Rewind;
  for var Short in FShorts do
    Short.Rewind;
  FOverloadShort.Rewind;
  FColumnOn := False;
  FColumn.Rewind;
  for var Dust in FWaveDust do
    Dust.Rewind;
  FArchSmoking := False;
  for var Smoke in FArchSmoke do
    Smoke.Rewind;
  FScrape.Clear;
  FWheelSparks.Clear;
  for var Smoke in FJetDust do
    Smoke.Rewind;
end;

// One that drives smokes hard, on the road or on the belt
procedure TRamPainter.TickExhausts(ABeltShift: Single);
begin
  if not FRam.Present then
    Exit;

  var Driving := (FRam.Phase in [rpDriving, rpRevving]) or (ABeltShift > 0);
  if Driving <> FExhaustDriving then
  begin
    FExhaustDriving := Driving;
    var Level: Single := ExhaustIdle;
    if Driving then
      Level := 1;
    for var Exhaust in FExhausts do
      Exhaust.FadeTo(Level, ExhaustRampTicks);
  end;
  for var Turned := False to True do
    for var i := Low(ExhaustPoints) to High(ExhaustPoints) do
    begin
      var Spot := FRam.PoseSpot(FRam.PoseAt(1), ExhaustPoints[i]);
      FExhausts[Turned][i].Drift(-ABeltShift, 0);
      FExhausts[Turned][i].Tick(Spot.X, Spot.Y,
        (Turned = FRam.HullMirrored) and not FRam.Flight.Running);
    end;
end;

// A wounded hunter smokes from its head; an empty mast from its top while
// it goes down and until the next head comes up
procedure TRamPainter.TickHeadSmoke(ABeltShift: Single);
begin
  if not FRam.Present then
    Exit;
  var Smoking := (FRam.Wounded or (FRam.Head = rhNone)) and (FRam.ShutterAt(1) < 1);
  if Smoking <> FHeadSmoking then
  begin
    FHeadSmoking := Smoking;
    FHeadSmoke.FadeTo(Ord(Smoking), HeadSmokeRampTicks);
  end;
  var Well := FRam.WellAt(FRam.Left);
  var Source := MastPivot(Well);
  Source.Y := Source.Y - FRam.Mast;
  if FRam.Head <> rhNone then
  begin
    var Shape := HeadShapes[FRam.Head];
    Source := HeadPoint(Well, FRam.Mast, FRam.SwayAt(1), FRam.Head,
      FRam.Facing, 1, Shape.Width / 2, Shape.Height / 2);
  end;
  Source := FRam.Posed(FRam.PoseAt(1), Source);
  FHeadSmoke.Drift(-ABeltShift, 0);
  FHeadSmoke.Tick(Source.X, Source.Y, True);
end;

// The head on the mast shorts out as hard as its lives say, the
// overloading sweeper thicker and thicker over that; the bolts of a head
// blown up die out where they struck
procedure TRamPainter.TickShorts;
begin
  if not FRam.Present then
    Exit;
  for var Head := Low(FShorts) to High(FShorts) do
  begin
    var OnTheMast := FRam.Head = Head;
    var Level: Single := 0;
    if OnTheMast then
      Level := FRam.ShortLevel;
    FShorts[Head].FadeTo(Level, 0);
    var Shape := HeadShapes[Head];
    var Middle := HeadPoint(FRam.WellAt(FRam.Left), FRam.Mast, FRam.SwayAt(1), Head,
      FRam.Facing, FRam.TurnSquash, Shape.Width / 2, Shape.Height / 2);
    FShorts[Head].Tick(Middle.X, Middle.Y, OnTheMast);
    if Head = rhSweeper then
    begin
      FOverloadShort.FadeTo(FRam.Overload, 0);
      FOverloadShort.Tick(Middle.X, Middle.Y, FRam.Overloading);
    end;
  end;
end;

// The column blows while the bunker vents; what it threw up rides the
// road away as the exhausts' smoke does
procedure TRamPainter.TickColumn(ABeltShift: Single);
begin
  if not FRam.Present then
    Exit;
  var Venting := (FRam.Head = rhBunker) and (FRam.Hatch = bhVenting);
  if Venting <> FColumnOn then
  begin
    FColumnOn := Venting;
    FColumn.FadeTo(Ord(Venting), 0);
  end;
  var Hatch := FRam.HatchPoint;
  FColumn.Drift(-ABeltShift, 0);
  FColumn.Tick(Hatch.X, Hatch.Y, Venting);
end;

// Where the front runs along the road - one point each side of the blast
// - the dust is kicked up; off the screen, or with no wave, none
procedure TRamPainter.TickWaveDust;
begin
  if not FRam.Present then
    Exit;
  var Front := FRam.WaveFrontAt(1);
  var Below := RamFloorY - FRam.BlastAt.Y;
  var Crossing := Front > Below;
  var Along: Single := 0;
  if Crossing then
    Along := Sqrt(Sqr(Front) - Sqr(Below));
  for var i := Low(FWaveDust) to High(FWaveDust) do
  begin
    var Side := 2 * i - 1;
    var X := FRam.BlastAt.X + Side * Along;
    var Kicking := Crossing and (X >= 0) and (X <= ScreenWidth);
    FWaveDust[i].FadeTo(Ord(Kicking), 0);
    FWaveDust[i].Tick(X, RamFloorY - WaveDustOverRoad, Kicking);
  end;
end;

procedure TRamPainter.TickArchSmoke(ABeltShift: Single);
begin
  if not FRam.Present then
    Exit;
  var Stunned := FRam.Stunned;
  if Stunned <> FArchSmoking then
  begin
    FArchSmoking := Stunned;
    FArchSmokeTicks := 0;
    for var Smoke in FArchSmoke do
      Smoke.FadeTo(Ord(Stunned), 0);
  end;
  if Stunned then
  begin
    Inc(FArchSmokeTicks);
    if FArchSmokeTicks = ArchSmokeThickTicks then
      for var Smoke in FArchSmoke do
        Smoke.FadeTo(ArchSmokeThin, ArchSmokeThinTicks);
  end;
  for var i := Low(FArchSmoke) to High(FArchSmoke) do
  begin
    var Spot := FRam.PoseSpot(FRam.PoseAt(1), ArchSmokePoints[i]);
    FArchSmoke[i].Drift(-ABeltShift, 0);
    FArchSmoke[i].Tick(Spot.X, Spot.Y, Stunned);
  end;
end;

// The road a burning jet reaches is blown into dust
procedure TRamPainter.TickJets;
begin
  if not FRam.Present then
    Exit;
  var Pose := FRam.PoseAt(1);
  for var Jet := Low(TTakeoffJet) to High(TTakeoffJet) do
  begin
    var Mouth := NozzleMouth(Pose, Jet, 1);
    var Reaches := (FRam.Flight.JetAt(Jet, 1) > 0) and
      (Mouth.Y + JetReach >= RamFloorY);
    FJetDust[Jet].Tick(Mouth.X, RamFloorY - WaveDustOverRoad, Reaches);
  end;
end;

// The middle of the nozzle's top edge, under the bay's ring
function TRamPainter.NozzleTop(const APose: TRamPose;
  AJet: TTakeoffJet): TSdlFPoint;
begin
  var Hang := Axles[JetAxles[AJet]];
  Hang.Y := Hang.Y + NozzleHang;
  Result := FRam.PoseSpot(APose, Hang);
end;

// The share of its height out of the ring: as far as the nozzles have
// come, and on the road no deeper than the road lets it
function TRamPainter.NozzleOut(const APose: TRamPose; AJet: TTakeoffJet;
  AAlpha: Single): Single;
begin
  var Top := NozzleTop(APose, AJet);
  var Room: Single := (RamFloorY + NozzleRoadSink - Top.Y) /
    (NozzleHeight * Cos(DegToRad(APose.Lean)));
  Result := EnsureRange(Min(FRam.Flight.NozzleAt(AAlpha), Room), 0.0, 1.0);
end;

// Where the fire leaves the nozzle: down the hull's own down from the top
// of the nozzle, as far as it is out
function TRamPainter.NozzleMouth(const APose: TRamPose; AJet: TTakeoffJet;
  AAlpha: Single): TSdlFPoint;
begin
  var Top := NozzleTop(APose, AJet);
  var Reach: Single := Max(NozzleHeight * NozzleOut(APose, AJet, AAlpha) -
    NozzleLipInset, 0);
  var Angle := DegToRad(APose.Lean);
  Result.X := Top.X - Reach * Sin(Angle);
  Result.Y := Top.Y + Reach * Cos(Angle);
end;

// Forward off the point of the plough, the way the bow faces
procedure TRamPainter.TickScrape;
begin
  FScrape.Tick;
  var Level := FRam.ScrapeLevel;
  if Level <= 0 then
    Exit;
  var Spray := Default(TSparkSpray);
  Spray.Count := Round(ScrapeSparks * Level);
  Spray.Heading := ScrapeHeading;
  if not FRam.HullMirrored then
    Spray.Heading := 180 - ScrapeHeading;
  Spray.Cone := ScrapeCone;
  Spray.SlowSpeed := ScrapeSlowSpeed;
  Spray.FastSpeed := ScrapeFastSpeed;
  var Nose := FRam.PoseSpot(FRam.PoseAt(1), NosePoint);
  FScrape.Spray(Nose.X, Nose.Y, Spray);
end;

procedure TRamPainter.TickWheelSparks;
begin
  FWheelSparks.Tick;
  SprayStrike(FRam.Wheel);
  SprayStrike(FRam.RearWheel);
end;

// Off the bottom of its rim, a hair over the road the sparks ring off
procedure TRamPainter.SprayStrike(const AWheel: TLooseWheel);
const
  OverTheRoad = 1.0;
begin
  var Share: Single := Min(AWheel.Struck / WheelHardStrike, 1);
  if Share <= 0 then
    Exit;
  var Spray := Default(TSparkSpray);
  Spray.Count := Max(Round(WheelSparks * Share), 1);
  Spray.Heading := 90;
  Spray.Cone := WheelSparkCone;
  Spray.SlowSpeed := ScrapeSlowSpeed;
  Spray.FastSpeed := Max(ScrapeFastSpeed * Share, ScrapeSlowSpeed);
  var Bottom := AWheel.Contact;
  FWheelSparks.Spray(Bottom.X, Bottom.Y - OverTheRoad, Spray);
end;

// The sections back to front - the narrowest rides out of the wider ones
// - each top raised by its share of the mast's rise, then the head on the
// top collar. All of it turned with the sway about the middle of the well.
procedure TRamPainter.DrawMast(const ASprites: TSpriteRenderer; AWell, AMast,
  ASway, AAlpha: Single);
begin
  var Pivot := MastPivot(AWell);
  var Rise := AMast - MastRest;
  for var Section := High(FArt.FMasts) downto Low(FArt.FMasts) do
  begin
    var Top := Pivot.Y - MastRest - Rise * Section / High(FArt.FMasts);
    var Middle := UnitPoint(Pivot.X, Top + MastLengths[Section] / 2);
    ASprites.DrawSized(FArt.FMasts[Section], Turned(Middle, Pivot, ASway),
      MastWidths[Section], MastLengths[Section], 1, FRam.HullMirrored, ASway);
  end;
  DrawHead(ASprites, AWell, AMast, ASway, AAlpha);
end;

// The head facing its way, squashed in a turn; the hunter's barrel over it
// on the sleeve, along its aim. The art faces left; facing right it is
// mirrored, and so is the barrel, which then lies along the aim from the
// other end.
procedure TRamPainter.DrawHead(const ASprites: TSpriteRenderer; AWell, AMast,
  ASway, AAlpha: Single);
begin
  var Head := FRam.Head;
  if Head = rhNone then
    Exit;
  var Shape := HeadShapes[Head];
  var Facing := FRam.Facing;
  var Squash := FRam.TurnSquash;
  var Mirrored := Facing > 0;
  var Texture := FArt.FHunter;
  case Head of
    rhSweeper:
      Texture := FArt.FSweeper;
    rhBunker:
      begin
        // Its art faces right
        Texture := FArt.FBunker;
        Mirrored := Facing < 0;
      end;
  end;
  ASprites.DrawSized(Texture, HeadPoint(AWell, AMast, ASway, Head, Facing,
    Squash, Shape.Width / 2, Shape.Height / 2), Shape.Width * Squash,
    Shape.Height, 1, Mirrored, ASway);
  if Head = rhBunker then
    DrawLid(ASprites, AWell, AMast, ASway, AAlpha);
  if Head <> rhHunter then
    Exit;

  var Sleeve := HeadPoint(AWell, AMast, ASway, rhHunter, Facing, Squash,
    HunterSleeveX, HunterSleeveY);
  var Along := FRam.AimAt(AAlpha) - ASway;
  var Barrel := Heading(Along);
  var Reach := BarrelPivotX - BarrelWidth / 2;
  var Turn := 180 - Along;
  if Mirrored then
    Turn := -Along;
  ASprites.DrawSized(FArt.FHunterBarrel, UnitPoint(Sleeve.X + Barrel.X * Reach,
    Sleeve.Y + Barrel.Y * Reach), BarrelWidth, BarrelHeight, 1, Mirrored, Turn);
end;

// The lid in the bunker's frame, turned about its hinge and moved toward
// where it lies shut by how shut it is. Worked out on the art as drawn
// facing right, then put into the left-facing frame of the heads; mirrored,
// the turn goes the other way.
procedure TRamPainter.DrawLid(const ASprites: TSpriteRenderer; AWell, AMast,
  ASway, AAlpha: Single);
begin
  var Shape := HeadShapes[rhBunker];
  var Shut := 1 - FRam.LidAt(AAlpha);
  var Turn := LidShutTurn * Shut;
  var Angle := DegToRad(Turn);
  var FromHingeX := Shape.Width / 2 - LidHinge.X;
  var FromHingeY := Shape.Height / 2 - LidHinge.Y;
  // Counter-clockwise on the screen, Y down
  var CenterX := LidHinge.X + FromHingeX * Cos(Angle) + FromHingeY * Sin(Angle) +
    LidShutShift.X * Shut;
  var CenterY := LidHinge.Y - FromHingeX * Sin(Angle) + FromHingeY * Cos(Angle) +
    LidShutShift.Y * Shut;
  var Squash := FRam.TurnSquash;
  var Mirrored := FRam.Facing < 0;
  var Clockwise := -Turn;
  if Mirrored then
    Clockwise := Turn;
  ASprites.DrawSized(FArt.FBunkerLid, HeadPoint(AWell, AMast, ASway, rhBunker,
    FRam.Facing, Squash, Shape.Width - CenterX, CenterY), Shape.Width * Squash,
    Shape.Height, 1, Mirrored, Clockwise + ASway);
end;

procedure TRamPainter.DrawTop(const ASprites: TSpriteRenderer; AWell, AMast,
  ASway, AAlpha: Single);
begin
  if not FRam.Armed then
    Exit;
  var Level: Single;
  var Color := LensColor;
  if FRam.Booting or FRam.Hurt then
  begin
    Level := 1;
    Color := HeatWhite;
  end
  else
    Level := Lerp(TopGlowLow, TopGlowHigh,
      0.5 - 0.5 * Cos(2 * Pi * (FAge + AAlpha) / TopGlowTicks));
  var Top := HeadPoint(AWell, AMast, ASway, rhBunker, FRam.Facing,
    FRam.TurnSquash, HatchX, HatchY);
  DrawGlowTurned(FArt.FRenderer, FArt.FGlow, Top.X + ASprites.Origin.X,
    Top.Y + ASprites.Origin.Y, TopGlowWidth * FRam.TurnSquash, TopGlowHeight,
    ASway, Color, Level);
end;

// The fire of the column over the open hatch: its puffs and a glow that
// stands in it, flickering, while it blows
procedure TRamPainter.DrawColumn(const ACanvas: TDynamicCanvas;
  AOrigin: TSdlPoint; AAlpha: Single);
begin
  FColumn.Draw(ACanvas, FColumn.Origin.X + AOrigin.X,
    FColumn.Origin.Y + AOrigin.Y, AAlpha);
  if not FColumnOn then
    Exit;
  var Hatch := FRam.HatchPoint;
  for var i := 0 to ColumnGlows - 1 do
  begin
    var Flicker := 1 - ColumnFlicker * Abs(Sin(FAge * ColumnFlickerRate +
      i * ColumnFlickerOffset));
    DrawGlow(FArt.FRenderer, FArt.FGlow, Hatch.X + AOrigin.X,
      Hatch.Y - ColumnHeight * (i + 0.5) / ColumnGlows + AOrigin.Y,
      ColumnGlowSize * (1 - 0.15 * i), ColumnHot,
      ColumnGlowLevel * Flicker * (1 - i / (ColumnGlows + 1)));
  end;
end;

// The barrels in white over the sweeper: red as they burn before and
// through a sweep, white while its row comes up, for a moment when they
// are struck, and as the overload whitens the head
procedure TRamPainter.DrawHeat(const ASprites: TSpriteRenderer; AWell, AMast,
  ASway, AAlpha: Single);
begin
  var Level := FRam.HeatAt(AAlpha);
  var Color := HeatRed;
  if FRam.Overloading then
  begin
    Level := FRam.Overload;
    Color := HeatWhite;
  end
  else if (Level <= 0) and (FRam.Booting or FRam.Hurt) then
  begin
    Level := 1;
    Color := HeatWhite;
  end;
  if Level <= 0 then
    Exit;
  var Shape := HeadShapes[rhSweeper];
  SDL_SetTextureColorMod(FArt.FSweeperHeat, Color.R, Color.G, Color.B);
  ASprites.DrawSized(FArt.FSweeperHeat, HeadPoint(AWell, AMast, ASway,
    rhSweeper, FRam.Facing, FRam.TurnSquash, Shape.Width / 2, Shape.Height / 2),
    Shape.Width * FRam.TurnSquash, Shape.Height, Level, FRam.Facing > 0, ASway);
end;

// The whole head whitening as the overload goes on: its art added over
// itself, brighter and brighter
procedure TRamPainter.DrawOverload(const ASprites: TSpriteRenderer; AWell,
  AMast, ASway: Single);
begin
  var Level := FRam.Overload;
  if Level <= 0 then
    Exit;
  var Shape := HeadShapes[rhSweeper];
  var Texture := FArt.FSweeper;
  SDL_SetTextureBlendMode(Texture, SdlBlendModeAdd);
  ASprites.DrawSized(Texture, HeadPoint(AWell, AMast, ASway, rhSweeper,
    FRam.Facing, FRam.TurnSquash, Shape.Width / 2, Shape.Height / 2),
    Shape.Width * FRam.TurnSquash, Shape.Height, OverloadWhite * Level,
    FRam.Facing > 0, ASway);
  SDL_SetTextureBlendMode(Texture, SdlBlendModeBlend);
end;

// The white of the blast: the whole frame for a moment, and a light about
// where the head burst
procedure TRamPainter.DrawFlash(AOrigin: TSdlPoint; AAlpha: Single);
begin
  var Level := FRam.FlashAt(AAlpha);
  if Level <= 0 then
    Exit;
  var Renderer := FArt.FRenderer;
  SDL_SetRenderDrawBlendMode(Renderer, SdlBlendModeBlend);
  SDL_SetRenderDrawColor(Renderer, FlashColor.R, FlashColor.G, FlashColor.B,
    Round(255 * FlashScreen * Sqr(Level)));
  SDL_RenderFillRectF(Renderer, nil);
  DrawGlow(Renderer, FArt.FGlow, FRam.BlastAt.X + AOrigin.X,
    FRam.BlastAt.Y + AOrigin.Y, FlashGlowSize * Level, FlashColor, Level);
end;

// The dark band behind, then the thin white front over it as a ring of
// triangles, both fading as the wave runs out
procedure TRamPainter.DrawWave(AOrigin: TSdlPoint; AAlpha: Single);
var
  Vertices: array [0..2 * WaveFrontSegments + 1] of TSdlVertex;
  Indices: array [0..6 * WaveFrontSegments - 1] of Integer;
begin
  var Front := FRam.WaveFrontAt(AAlpha);
  if Front <= 0 then
    Exit;
  var Fade := 1 - Front / FRam.WaveReach;
  var CenterX := FRam.BlastAt.X + AOrigin.X;
  var CenterY := FRam.BlastAt.Y + AOrigin.Y;
  var Renderer := FArt.FRenderer;
  DrawGlow(Renderer, FArt.FWaveBand, CenterX, CenterY, 2 * Front, WaveBlack,
    WaveBandDepth * Fade);

  var Color := Default(TSdlColor);
  Color.R := 255;
  Color.G := 255;
  Color.B := 255;
  Color.A := Round(255 * WaveFrontLevel * Fade);
  var Inner := Max(0, Front - WaveFrontWidth);
  for var i := 0 to WaveFrontSegments do
  begin
    var Angle := 2 * Pi * i / WaveFrontSegments;
    Vertices[2 * i].Position := UnitPoint(CenterX + Front * Cos(Angle),
      CenterY + Front * Sin(Angle));
    Vertices[2 * i + 1].Position := UnitPoint(CenterX + Inner * Cos(Angle),
      CenterY + Inner * Sin(Angle));
    Vertices[2 * i].Color := Color;
    Vertices[2 * i + 1].Color := Color;
  end;
  for var i := 0 to WaveFrontSegments - 1 do
  begin
    Indices[6 * i] := 2 * i;
    Indices[6 * i + 1] := 2 * i + 1;
    Indices[6 * i + 2] := 2 * i + 2;
    Indices[6 * i + 3] := 2 * i + 1;
    Indices[6 * i + 4] := 2 * i + 3;
    Indices[6 * i + 5] := 2 * i + 2;
  end;
  SDL_SetRenderDrawBlendMode(Renderer, SdlBlendModeBlend);
  SDL_RenderGeometry(Renderer, nil, @Vertices[0], Length(Vertices),
    @Indices[0], Length(Indices));
end;

// In each arch, behind the hull and its wheels: the bay out of the depth -
// growing, out of the dark of the chassis - and the nozzle out of its
// ring, lit from below while its fire burns. The rear one comes out behind
// its wheel.
procedure TRamPainter.DrawEngines(const ASprites: TSpriteRenderer;
  const APose: TRamPose; AAlpha: Single);
begin
  var Bay := FRam.Flight.BayAt(AAlpha);
  if Bay <= 0 then
    Exit;
  var Mirrored := FRam.HullMirrored;
  var Size := Lerp(BayDepth, 1, Bay);
  for var Jet := Low(TTakeoffJet) to High(TTakeoffJet) do
  begin
    var Axle := FRam.PoseSpot(APose, Axles[JetAxles[Jet]]);
    ASprites.DrawSized(FArt.FBay, Axle, BayWidth * Size, BayHeight * Size, Bay,
      Mirrored, APose.Lean);
    var Top := NozzleTop(APose, Jet);
    var Shown := NozzleOut(APose, Jet, AAlpha);
    ASprites.DrawHanging(FArt.FNozzle, Top, NozzleWidth, NozzleHeight, Shown, 1,
      Mirrored, APose.Lean);
    var Fire := Min(FRam.Flight.JetAt(Jet, AAlpha), 1);
    if Fire > 0 then
      ASprites.DrawHanging(FArt.FNozzleLit, Top, NozzleWidth, NozzleHeight,
        Shown, Fire, Mirrored, APose.Lean);
  end;
end;

// Over the hull, slid shut from the far edge toward the eye: it shuts with
// the hull upright on the road, so a level line cuts what is not there yet
procedure TRamPainter.DrawShutter(const ASprites: TSpriteRenderer;
  const APose: TRamPose; AAlpha: Single);
begin
  var Shut := FRam.ShutterAt(AAlpha);
  if Shut <= 0 then
    Exit;
  var Center := FRam.PoseSpot(APose, WellPoint);
  if Shut < 1 then
    ASprites.ClipAbove(Center.Y + ShutterHeight * (Shut - 0.5));
  ASprites.DrawSized(FArt.FShutter, Center, ShutterWidth, ShutterHeight, 1,
    FRam.HullMirrored, APose.Lean);
  ASprites.ClearClip;
end;

procedure TRamPainter.DrawLamps(const ASprites: TSpriteRenderer;
  const APose: TRamPose; AAlpha: Single);
begin
  var Level := FRam.LampsAt(AAlpha);
  if Level <= 0 then
    Exit;
  for var Lamp in LampPoints do
  begin
    var Spot := FRam.PoseSpot(APose, Lamp);
    DrawGlow(FArt.FRenderer, FArt.FGlow, Spot.X + ASprites.Origin.X,
      Spot.Y + ASprites.Origin.Y, LampSize, LampColor, Level);
  end;
end;

procedure TRamPainter.DrawEye(const ASprites: TSpriteRenderer;
  const APose: TRamPose; AAlpha: Single);
begin
  var Level := FRam.EyeAt(AAlpha);
  if Level <= 0 then
    Exit;
  var Spot := FRam.PoseSpot(APose, EyePoint);
  DrawGlow(FArt.FRenderer, FArt.FGlow, Spot.X + ASprites.Origin.X,
    Spot.Y + ASprites.Origin.Y, Lerp(EyeRestSize, EyeFlashSize, Sqr(Level)),
    EyeColor, Level);
end;

procedure TRamPainter.DrawEyeOverDark(AOrigin: TSdlPoint; AAlpha,
  ADepth: Single);
begin
  if not FRam.Present or (ADepth <= 0) then
    Exit;
  var Level := FRam.EyeAt(AAlpha);
  if Level <= 0 then
    Exit;
  var Spot := FRam.PoseSpot(FRam.PoseAt(AAlpha), EyePoint);
  DrawGlow(FArt.FRenderer, FArt.FGlow, Spot.X + AOrigin.X, Spot.Y + AOrigin.Y,
    Lerp(EyeRestSize, EyeFlashSize, Sqr(Level)), EyeColor, Level * ADepth);
end;

// Turning round beyond the left edge it is not drawn: its eye's red is
// thrown on the edge, blinking, brighter the nearer it is to coming back
procedure TRamPainter.DrawPeek(AOrigin: TSdlPoint; AAlpha: Single);
begin
  var Level := FRam.PeekLevel * FRam.EyeAt(AAlpha);
  if Level <= 0 then
    Exit;
  DrawGlow(FArt.FRenderer, FArt.FGlow, AOrigin.X,
    RamTop + EyePoint.Y + AOrigin.Y, PeekSize, EyeColor, Level);
end;

// On the hunter's head, turned and squashed as the head is: pale and
// winking, red and bigger while it burns, a flash when it is struck
procedure TRamPainter.DrawLens(const ASprites: TSpriteRenderer; AWell, AMast,
  ASway, AAlpha: Single);
begin
  if FRam.Head <> rhHunter then
    Exit;
  var Level := FRam.LensAt(AAlpha);
  if Level <= 0 then
    Exit;
  var Lens := HeadPoint(AWell, AMast, ASway, rhHunter, FRam.Facing,
    FRam.TurnSquash, HunterLensX, HunterLensY);
  var Size := Lerp(LensEmberSize, LensWinkSize, Level);
  var Color := LensColor;
  if FRam.LensHot then
  begin
    Size := Lerp(LensEmberSize, LensHotSize, Level);
    Color := LensHotColor;
  end
  else if FRam.Hurt then
    Size := LensHurtSize;
  DrawGlow(FArt.FRenderer, FArt.FGlow, Lens.X + ASprites.Origin.X,
    Lens.Y + ASprites.Origin.Y, Size, Color, Level);
end;

// Back to front: the dark of the well, the arches, the engine bays and
// their nozzles, the wheels, the
// mast as far as it stays in the hull, the hull with its eye, and what of
// the mast and the head - and the lens - stands over the middle line of
// the well once more, over the hull; the wheels it has shed over it all.
// The mast is cut by level lines, which neither lean nor rise with the
// hull: a hull leaves the road's upright only with its mast at rest, out
// of sight, and it is not drawn.
procedure TRamPainter.DrawBody(const ASprites: TSpriteRenderer;
  AAlpha: Single);
begin
  if not FRam.Present then
    Exit;
  var Pose := FRam.PoseAt(AAlpha);
  var Left := Pose.Left;
  var Stand := Default(THullStand);
  Stand.Center := UnitPoint(Left + RamWidth / 2 + Pose.Shift.X,
    RamTop + RamHeight / 2 + Pose.Shift.Y);
  Stand.Mirrored := FRam.HullMirrored;
  Stand.Lean := Pose.Lean;
  var Pivot := FRam.LeanPivot(Left);
  Stand.Pivot := UnitPoint(Pivot.X + Pose.Shift.X, Pivot.Y + Pose.Shift.Y);
  if FRam.WheelShed then
    Stand.Shed := [FrontAxle];
  if FRam.Flight.Spat then
    Stand.Shed := Stand.Shed + [RearAxle];
  var Moved := not Pose.Upright;
  var Well := FRam.WellAt(Left);
  var Mast := FRam.MastAt(AAlpha);
  var Sway := FRam.SwayAt(AAlpha);

  ASprites.DrawSized(FArt.FWell, Stand.TurnedCenter, RamWidth, RamHeight, 1,
    Stand.Mirrored, Stand.Lean);
  FHull.DrawChassis(ASprites, Stand);
  DrawEngines(ASprites, Pose, AAlpha);
  FHull.DrawWheels(ASprites, Stand, AAlpha);
  if not Moved then
  begin
    ASprites.ClipAbove(RamTop + MastHiddenBelow);
    DrawMast(ASprites, Well, Mast, Sway, AAlpha);
    ASprites.ClearClip;
  end;
  FHull.DrawBody(ASprites, Stand, AAlpha);
  DrawEye(ASprites, Pose, AAlpha);
  if not Moved then
  begin
    ASprites.ClipAbove(RamTop + WellY);
    DrawMast(ASprites, Well, Mast, Sway, AAlpha);
    DrawLens(ASprites, Well, Mast, Sway, AAlpha);
    // Once: the mast is drawn twice, and the heat and the light are
    // see-through
    if FRam.Head = rhBunker then
      DrawTop(ASprites, Well, Mast, Sway, AAlpha);
    if FRam.Head = rhSweeper then
    begin
      DrawOverload(ASprites, Well, Mast, Sway);
      DrawHeat(ASprites, Well, Mast, Sway, AAlpha);
    end;
    ASprites.ClearClip;
  end;
  DrawShutter(ASprites, Pose, AAlpha);
  DrawLamps(ASprites, Pose, AAlpha);

  var Wheel := FRam.Wheel;
  if Wheel.Running then
    FHull.DrawWheel(ASprites, Wheel.CenterAt(AAlpha), Wheel.TurnAt(AAlpha));
  Wheel := FRam.RearWheel;
  if Wheel.Running then
    FHull.DrawWheel(ASprites, Wheel.CenterAt(AAlpha), Wheel.TurnAt(AAlpha));
end;

procedure TRamPainter.DrawSmoke(const ACanvas: TDynamicCanvas;
  AOrigin: TSdlPoint; AAlpha: Single);
begin
  if not FRam.Present then
    Exit;
  for var Exhaust in FExhausts do
    Exhaust.Draw(ACanvas, Exhaust.Origin.X + AOrigin.X,
      Exhaust.Origin.Y + AOrigin.Y, AAlpha);
  FHeadSmoke.Draw(ACanvas, FHeadSmoke.Origin.X + AOrigin.X,
    FHeadSmoke.Origin.Y + AOrigin.Y, AAlpha);
  for var Dust in FJetDust do
    Dust.Draw(ACanvas, Dust.Origin.X + AOrigin.X, Dust.Origin.Y + AOrigin.Y,
      AAlpha);
  DrawFlames(ACanvas.Renderer, AOrigin, AAlpha);
end;

// Straight out of each burning nozzle along the hull's own down, the
// sheath and the core, longer as the jet flares; each flickers out of
// step with the other
procedure TRamPainter.DrawFlames(ARenderer: PSdlRenderer; AOrigin: TSdlPoint;
  AAlpha: Single);
const
  FlareMost = 1.5;
  // Two waves beating against each other, radians a tick; the rear jet
  // that many ticks along
  FlickerFast = 1.9;
  FlickerSlow = 0.67;
  JetsApartTicks = 17;
begin
  var Pose := FRam.PoseAt(AAlpha);
  var Angle := DegToRad(Pose.Lean);
  for var Jet := Low(TTakeoffJet) to High(TTakeoffJet) do
  begin
    var Level: Single := Min(FRam.Flight.JetAt(Jet, AAlpha), FlareMost);
    if Level <= 0 then
      Continue;
    var Phase: Single := FAge + AAlpha + Ord(Jet) * JetsApartTicks;
    var Flicker := 1 + FlameFlicker * Sin(Phase * FlickerFast) *
      Cos(Phase * FlickerSlow);
    var Mouth := NozzleMouth(Pose, Jet, AAlpha);
    var Shown := Min(Level, 1);
    var Sheath := FlameLength * Level * Flicker;
    DrawGlowTurned(ARenderer, FArt.FFlame,
      Mouth.X - Sheath / 2 * Sin(Angle) + AOrigin.X,
      Mouth.Y + Sheath / 2 * Cos(Angle) + AOrigin.Y,
      FlameWidth, Sheath, Pose.Lean, FlameColor, Shown);
    var Core := FlameCoreLength * Level * Flicker;
    DrawGlowTurned(ARenderer, FArt.FFlame,
      Mouth.X - Core / 2 * Sin(Angle) + AOrigin.X,
      Mouth.Y + Core / 2 * Cos(Angle) + AOrigin.Y,
      FlameCoreWidth, Core, Pose.Lean, FlameCoreColor, Shown);
  end;
end;

// At the mouth of each nozzle that burns: the fire's glow and its white
// core over the lip, swelling as the jet flares; and its warmth on the
// road under it, the nearer the warmer
procedure TRamPainter.DrawJetGlow(AOrigin: TSdlPoint; AAlpha: Single);
begin
  var Pose := FRam.PoseAt(AAlpha);
  for var Jet := Low(TTakeoffJet) to High(TTakeoffJet) do
  begin
    var Level := FRam.Flight.JetAt(Jet, AAlpha);
    if Level <= 0 then
      Continue;
    var Mouth := NozzleMouth(Pose, Jet, AAlpha);
    var X := Mouth.X + AOrigin.X;
    var Y := Mouth.Y + AOrigin.Y;
    DrawGlow(FArt.FRenderer, FArt.FGlow, X, Y, JetGlowSize * Level,
      JetGlowColor, Level);
    DrawGlow(FArt.FRenderer, FArt.FGlow, X, Y, JetCoreSize * Level,
      JetCoreColor, Level);
    var Warmth := WarmLevel * Min(Level, 1) *
      (1 - EnsureRange((RamFloorY - Mouth.Y) / WarmReach, 0.0, 1.0));
    if Warmth > 0 then
      DrawGlowTurned(FArt.FRenderer, FArt.FGlow, X,
        RamFloorY + WarmDrop + AOrigin.Y, WarmWidth, WarmHeight, 0, WarmColor,
        Warmth);
  end;
end;

procedure TRamPainter.DrawLight(const ACanvas: TDynamicCanvas;
  AOrigin: TSdlPoint; AAlpha: Single);
begin
  if not FRam.Present then
    Exit;
  for var Dust in FWaveDust do
    Dust.Draw(ACanvas, Dust.Origin.X + AOrigin.X, Dust.Origin.Y + AOrigin.Y,
      AAlpha);
  for var Smoke in FArchSmoke do
    Smoke.Draw(ACanvas, Smoke.Origin.X + AOrigin.X, Smoke.Origin.Y + AOrigin.Y,
      AAlpha);
  FScrape.Draw(SparkBrush(ACanvas.Renderer, ACanvas.StreakGlow),
    UnitPoint(AOrigin.X, AOrigin.Y), AAlpha);
  FWheelSparks.Draw(SparkBrush(ACanvas.Renderer, ACanvas.StreakGlow),
    UnitPoint(AOrigin.X, AOrigin.Y), AAlpha);
  DrawJetGlow(AOrigin, AAlpha);
  for var Short in FShorts do
    Short.Draw(ACanvas, Short.Origin.X + AOrigin.X, Short.Origin.Y + AOrigin.Y,
      AAlpha);
  FOverloadShort.Draw(ACanvas, FOverloadShort.Origin.X + AOrigin.X,
    FOverloadShort.Origin.Y + AOrigin.Y, AAlpha);
  DrawPeek(AOrigin, AAlpha);
  var Left := FRam.LeftAt(AAlpha);
  var Well := FRam.WellAt(Left);
  var Middle := UnitPoint(Left + FRam.Body.Middle.X + AOrigin.X,
    RamTop + FRam.Body.Middle.Y + AOrigin.Y);
  FRam.Shield.Draw(ACanvas, FArt.FShield, Middle, AAlpha);
  if (FRam.Head = rhBunker) and FRam.Armed then
  begin
    var Shape := HeadShapes[rhBunker];
    var Dome := HeadPoint(Well, FRam.MastAt(AAlpha), FRam.SwayAt(AAlpha),
      rhBunker, FRam.Facing, FRam.TurnSquash, Shape.Width / 2, Shape.Height / 2);
    FRam.HeadShield.Draw(ACanvas, FArt.FShield,
      UnitPoint(Dome.X + AOrigin.X, Dome.Y + AOrigin.Y), AAlpha);
  end;
  DrawColumn(ACanvas, AOrigin, AAlpha);
  if (FRam.Head = rhSweeper) and FRam.Armed then
  begin
    var Mast := FRam.MastAt(AAlpha);
    var Sway := FRam.SwayAt(AAlpha);
    for var i := Low(PlateMiddles) to High(PlateMiddles) do
    begin
      var Plate := HeadPoint(Well, Mast, Sway, rhSweeper, FRam.Facing,
        FRam.TurnSquash, PlateMiddles[i].X, PlateMiddles[i].Y);
      FRam.Plate(i).Draw(ACanvas, FArt.FShield,
        UnitPoint(Plate.X + AOrigin.X, Plate.Y + AOrigin.Y), AAlpha);
    end;
  end;
  DrawWave(AOrigin, AAlpha);
  DrawFlash(AOrigin, AAlpha);
end;

end.
