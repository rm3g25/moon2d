# ============================================================
#  Moon2D - .gitattributes
# ============================================================
# Windows-only project. Sources are CRLF + UTF-8 BOM. The BOM is
# mandatory: without it Delphi 12 reads Cyrillic string literals as
# CP1251 and the game ships mojibake (see PORTING-NOTES.md).
#
# Hence: no end-of-line conversion anywhere, in either direction.
# Git stores every byte exactly as it was written.

* -text

# ---- Explicitly binary: never diff, never attempt a merge ----
*.bmp     binary
*.png     binary
*.jpg     binary
*.ogg     binary
*.wav     binary
*.dll     binary
*.exe     binary
*.res     binary

# The .mns and default.txt frame lists retired with the loose images:
# frame order lives in each set's manifest now.

# ---- GitHub Linguist hints ----
*.pas     linguist-language=Pascal
*.dpr     linguist-language=Pascal
*.dproj   linguist-generated=true

# Sprite sets are binary, but their manifest is text. Teach git to show
# it and a renamed sprite or a reordered animation reads as a line
# instead of "binary files differ". Needs one local setting, once:
#   git config diff.mset.textconv "bin/SpritePackCli.exe list"
*.mset diff=mset
