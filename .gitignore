# ============================================================
#  Moon2D - .gitignore
# ============================================================

# ---- Delphi build output ----
*.dcu
*.exe
*.map
*.drc
*.rsm
*.identcache
*.stat
*.~*
__history/
__recovery/
Win32/
Win64/
Debug/
Release/

# ---- Per-machine IDE state, not project state ----
*.local
*.dsk
*.tvsconfig
*.deployproj
*.otares

# ---- TitleCard: generated cards and local settings ----
# The .res belongs in the repository - it is part of the build, like
# Moon2D.res. Only the output and the machine-local ini stay out.
tools/TitleCard/cards/
tools/TitleCard/*.ini
bin/TitleCard.ini

# ---- Scratch ----
structure.txt
tracked.txt

# ---- OS clutter ----
Thumbs.db
desktop.ini
.DS_Store

# ---- Selene: the extracted input and the review sheet ----
# out/ keeps the approved maps and the globe; the rest regenerates.
tools/Selene/moonmap.png
tools/Selene/out/selene-sheet.png
__pycache__/
