# ============================================================
#  Moon2D - .gitignore
# ============================================================

# ---- Delphi build output ----
*.dcu
*.exe
*.map
*.drc
*.rsm
*.identcache
*.stat
*.~*
__history/
__recovery/
Win32/
Win64/
Debug/
Release/

# ---- Per-machine IDE state, not project state ----
*.local
*.dsk
*.tvsconfig
*.deployproj
*.otares

# ---- Soundtrack ----
# Kept out for size, not for rights: 17 MB of audio that gets revised
# far more often than the engine does. Ships with the release archives.
music/

# ---- TitleCard: generated cards and local settings ----
# The .res belongs in the repository - it is part of the build, like
# Moon2D.res. Only the output and the machine-local ini stay out.
tools/TitleCard/cards/
tools/TitleCard/*.ini
bin/TitleCard.ini

# ---- Local runtime configuration ----
# Uncomment once the game ships config.default.json and writes config.json itself
# config.json

# ---- Scratch ----
structure.txt
tracked.txt

# ---- OS clutter ----
Thumbs.db
desktop.ini
.DS_Store
